#!/usr/bin/make -f
export DH_VERBOSE = 1

%:
	dh $@ --with python3

clean:
	if command -v dh >/dev/null 2>&1; then \
		dh clean --with python3; \
	else \
		rm -rf debian/safeer-browser debian/files debian/*.substvars; \
	fi
	rm -rf __pycache__ */__pycache__ *.pyc */*.pyc

override_dh_auto_build:
	# Pure python application, no compilation needed

override_dh_auto_test:
	# Skip tests in packaging pipeline

override_dh_auto_clean:
	rm -rf __pycache__ */__pycache__ *.pyc */*.pyc

override_dh_auto_install:
	# Isti tovor kot build_deb.sh, Flatpak in AppImage (GTK4 brskalnik safeer_brskalnik.py, WebKitGTK 6.0):
	# en vir resnice, da izvorni paket ne namesti drugega brskalnika kot .deb.
	bash packaging/install_payload.sh debian/safeer-browser/usr
	sed -i 's|^Exec=safeer|Exec=/usr/bin/safeer|' debian/safeer-browser/usr/share/applications/safeer-browser.desktop
