# Vsaka izdaja objavi svoj SHA256SUMS kot prilogo; kopija v repozitoriju bi bila stara.
/SHA256SUMS

# tests/: v repozitorij gredo samo pravi testi in njihove priloge. Pomozne skripte sej (_*.py, hubr_*, sonda_* ...),
# dnevniki in posnetki vsebujejo naslove naprav in ostanejo samo na razvojnem racunalniku.
tests/*
!tests/test_*.py
!tests/conftest.py
!tests/besedila_namizja.py
!tests/dostop_za_preizkus.py
!tests/lazni_imap.py
!tests/wayland_okolje.py
!tests/zasebno_vodilo.py
!tests/test_*.js
!tests/README.md
!tests/fixtures/
!tests/results/
!tests/auth_compat_runtime.py
!tests/live_obremenitev.py
!tests/login_runtime.py
!tests/network_runtime.py
!tests/pomoc_internet.py
!tests/stability_runtime.py
!tests/youtube_live.py
!tests/youtube_startup.py

