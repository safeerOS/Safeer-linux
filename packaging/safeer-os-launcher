#!/usr/bin/env bash
# ==============================================================================
# Safeer OS (Linux) — application launcher (shared by .deb, AppImage, Flatpak and source checkout).
# Resolves the payload relative to its own location, like the Safeer Control launcher.
#
# The launcher also supervises the app: if Safeer OS dies from a signal (a crash inside a C
# library, an out-of-memory kill), the desktop would simply be gone with no explanation. Instead
# the launcher writes a line to ~/.cache/safeer-os/dnevnik.log and starts it again, at most a few
# times in a row (core/os_stabilnost.py then falls back to a safe mode). A normal exit, a version
# query or a screenshot run is never restarted.
#
# Whatever happens, Linux Mint underneath must stay usable: in desktop mode Safeer OS hides the
# Cinnamon panel, so any exit that is not a clean one ends with `safeer_os.py --vrni-mint`, which
# puts the panel back. Mint is the safety net under the shell, never its hostage.
# ==============================================================================
PRG="$0"
while [ -h "$PRG" ]; do
    link="$(readlink "$PRG")"
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG="$(dirname "$PRG")/$link" ;;
    esac
done
BIN_DIR="$(cd "$(dirname "$PRG")" && pwd)"
APP_DIR="$(cd "$BIN_DIR/../lib/safeer-os" && pwd)" || {
    echo "Safeer OS: application payload not found next to launcher." >&2
    exit 1
}
# Flatpak: system tools (nmcli, pactl, resolvectl, pkexec ...) live on the host; /app/host-bin holds
# wrappers that run them through flatpak-spawn --host (packaging/flatpak_host_wrappers.sh).
if [ -n "${FLATPAK_ID:-}" ] && [ -d /app/host-bin ]; then
    export PATH="/app/host-bin:$PATH"
    # Same settings, sign-in, trust and messages as the .deb: the Flatpak would otherwise keep its own copy in
    # ~/.var/app (and ask to sign in to Safeer Link again). --filesystem=home makes these folders reachable.
    export XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$HOME/.cache"
fi

PY="${PYTHON:-python3}"

# One-shot runs (version, screenshot) and an explicitly disabled supervisor run in the foreground.
for arg in "$@"; do
    case "$arg" in
        --version|--posnetek|--help|-h) exec "$PY" "$APP_DIR/safeer_os.py" "$@" ;;
    esac
done
# Flatpak is the main way Safeer OS is delivered (owner, 12 Oct 2026): it runs on the GNOME runtime, so the
# web engine (WebKitGTK) is current without waiting for Ubuntu. The .deb keeps the system parts (login and boot
# look, Cinnamon, start at login). When the Safeer OS Flatpak and its runtime are installed and the Flatpak is not
# older than this package, the .deb launcher starts the Flatpak instead. SAFEER_OS_BREZ_FLATPAKA=1 keeps the .deb.
if [ -z "${FLATPAK_ID:-}" ] && [ -z "${SAFEER_OS_BREZ_FLATPAKA:-}" ] && [ "$APP_DIR" = "/usr/lib/safeer-os" ] \
        && command -v flatpak >/dev/null 2>&1; then
    FP_ID="io.github.memelandfaner.SafeerOS"
    FP_DIR="$(flatpak info --show-location "$FP_ID" 2>/dev/null)"
    FP_RT="$(flatpak info --show-runtime "$FP_ID" 2>/dev/null)"
    FP_VER="$(cat "$FP_DIR/files/lib/safeer-os/packaging/VERSION_OS" 2>/dev/null)"
    NAS_VER="$(cat "$APP_DIR/packaging/VERSION_OS" 2>/dev/null)"
    if [ -n "$FP_VER" ] && [ -n "$FP_RT" ] && flatpak info "$FP_RT" >/dev/null 2>&1 \
            && { [ -z "$NAS_VER" ] || dpkg --compare-versions "$FP_VER" ge "$NAS_VER" 2>/dev/null; }; then
        exec flatpak run "$FP_ID" "$@"
    fi
fi
if [ -n "${SAFEER_OS_BREZ_NADZORA:-}" ]; then
    exec "$PY" "$APP_DIR/safeer_os.py" "$@"
fi

DNEVNIK="${XDG_CACHE_HOME:-$HOME/.cache}/safeer-os/dnevnik.log"
mkdir -p "$(dirname "$DNEVNIK")" 2>/dev/null
# stderr Pythona in WebKita (g_error, g_critical, opozorila GTK) gre v sled.log, ce ni terminala. Lastnik, 16. 10. 2026:
# Safeer OS je ob odpiranju Sporocil koncal s SIGTRAP (fatalno sporocilo WebKita), safeer-cinnamon pa je stderr poslal
# v /dev/null - besedilo napake je bilo izgubljeno. Velikost omejimo ob vsakem zagonu (tu) in med delom
# (core/os_stabilnost.vkljuci), da dolg dan z opozorili ne napolni diska.
SLED="${XDG_CACHE_HOME:-$HOME/.cache}/safeer-os/sled.log"
NAJVEC_SLEDI=262144
obrezi_sled() {
    local velikost
    velikost=$(stat -c %s "$SLED" 2>/dev/null || echo 0)
    if [ "$velikost" -gt "$NAJVEC_SLEDI" ]; then
        local rep
        rep="$(tail -c $((NAJVEC_SLEDI / 2)) "$SLED" 2>/dev/null)"
        # Isti inode (ne mv): ce kaj se pise vanj, pise naprej v isto datoteko.
        { echo "... (starejsi zapisi so odrezani)"; printf '%s\n' "$rep"; } > "$SLED" 2>/dev/null || true
    fi
}

# Puts the Cinnamon panel back if Safeer OS left it hidden. Idempotent: with nothing stored it is a
# no-op, so it is safe to call on every non-clean exit.
vrni_mint() {
    "$PY" "$APP_DIR/safeer_os.py" --vrni-mint >> "$DNEVNIK" 2>&1 || true
}

NAJVEC_ZAGONOV=5          # more than this in the window below means restarting does not help
OKNO_S=600
zacetek_okna=$(date +%s)
zagonov=0

while :; do
    if [ -t 2 ]; then
        "$PY" "$APP_DIR/safeer_os.py" "$@"
    else
        obrezi_sled
        # Tudi stdout (g_print knjiznic C; print() Pythona preusmeri core/os_stabilnost.preusmeri_izpis): pri zagonu iz
        # menija ali ob prijavi je bil /dev/null in sporocila o napakah so se izgubila (lastnik, 18. 10. 2026).
        "$PY" "$APP_DIR/safeer_os.py" "$@" >>"$SLED" 2>&1
    fi
    koda=$?
    [ "$koda" -eq 0 ] && exit 0                       # normal exit: Safeer OS already restored the panel
    if [ "$koda" -lt 128 ]; then                      # ordinary error: report it, do not loop
        vrni_mint
        exit "$koda"
    fi
    vrni_mint                                         # crash: the panel must be back before the retry

    zdaj=$(date +%s)
    if [ $((zdaj - zacetek_okna)) -gt "$OKNO_S" ]; then
        zacetek_okna=$zdaj
        zagonov=0
    fi
    zagonov=$((zagonov + 1))
    signal=$((koda - 128))
    echo "$(date '+%Y-%m-%d %H:%M:%S') zaganjalnik: Safeer OS se je ustavil zaradi signala $signal (poskus $zagonov)" >> "$DNEVNIK"
    "$PY" -c "import sys; sys.path.insert(0, '$APP_DIR'); from core import os_stabilnost; os_stabilnost.zabelezi_sesutje('safeer-os', $koda)" 2>/dev/null

    if [ "$zagonov" -ge "$NAJVEC_ZAGONOV" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') zaganjalnik: prevec ponovnih zagonov, odneham (glej sled.log)" >> "$DNEVNIK"
        vrni_mint
        exit "$koda"
    fi
    sleep 2
done
