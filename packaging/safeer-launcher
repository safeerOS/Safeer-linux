#!/usr/bin/env bash
# ==============================================================================
# Safeer Browser — shared application launcher
# Used by all Linux distribution formats (.deb, Flatpak, AppImage).
# Resolves the app payload relative to its own location so the exact same
# script works from /usr/bin, /app/bin and <AppDir>/usr/bin.
# ==============================================================================
PRG="$0"

while [ -h "$PRG" ]; do
    link="$(readlink "$PRG")"
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG="$(dirname "$PRG")/$link" ;;
    esac
done

BIN_DIR="$(cd "$(dirname "$PRG")" && pwd)"
APP_DIR="$(cd "$BIN_DIR/../lib/safeer-browser" && pwd)" || {
    echo "Safeer: application payload not found next to launcher." >&2
    exit 1
}

# Safeer Browser na GTK4 (safeer_brskalnik.py, WebKitGTK 6.0).
VSTOP="$APP_DIR/safeer_brskalnik.py"
PY="${PYTHON:-python3}"

# Flatpak (od 1.0.127): brez ovojev /app/host-bin in brez preusmeritve XDG_* v dom - brskalnik nima dostopa do
# gostitelja. Skupno mapo nastavitev s paketom .deb (~/.config/safeer-mint) izbere safeer_brskalnik.py.

# Enkratni zagoni (razlicica) brez preusmeritve v Flatpak in brez obsega systemd.
for arg in "$@"; do
    case "$arg" in
        --version|--help|-h) exec "$PY" "$VSTOP" "$@" ;;
    esac
done

# Od 15. 10. 2026 ima tudi .deb nas WebKitGTK s popravki (/usr/lib/safeer-browser/webkit, core/zasebni_webkit.py). Kot
# pri Safeer OS: ce sta Flatpak Safeer Browser in njegov runtime namescena in Flatpak ni starejsi od tega paketa,
# zaganjalnik .deb zazene Flatpak (podatki so isti, glej zgoraj; uporabnik, ki je namestil Flatpak, je izbral njegov
# peskovnik). SAFEER_BRSKALNIK_BREZ_FLATPAKA=1 obdrzi .deb.
if [ -z "${FLATPAK_ID:-}" ] && [ -z "${SAFEER_BRSKALNIK_BREZ_FLATPAKA:-}" ] && [ "$APP_DIR" = "/usr/lib/safeer-browser" ] \
        && command -v flatpak >/dev/null 2>&1; then
    FP_ID="io.github.memelandfaner.SafeerBrowser"
    FP_DIR="$(flatpak info --show-location "$FP_ID" 2>/dev/null)"
    FP_RT="$(flatpak info --show-runtime "$FP_ID" 2>/dev/null)"
    FP_VER="$(cat "$FP_DIR/files/lib/safeer-browser/packaging/VERSION" 2>/dev/null)"
    NAS_VER="$(cat "$APP_DIR/packaging/VERSION" 2>/dev/null)"
    if [ -n "$FP_VER" ] && [ -n "$FP_RT" ] && flatpak info "$FP_RT" >/dev/null 2>&1 \
            && { [ -z "$NAS_VER" ] || dpkg --compare-versions "$FP_VER" ge "$NAS_VER" 2>/dev/null; }; then
        exec flatpak run "$FP_ID" "$@"
    fi
fi

# Keep the rest of the desktop responsive when a page misbehaves: run the browser (and every
# web process it spawns) in its own user cgroup scope. MemoryHigh makes the kernel reclaim from
# Safeer first instead of pushing the whole session into swap; CPUWeight ranks it slightly below
# other applications. No privileges needed; silently skipped where there is no user manager
# (Flatpak, containers, plain X sessions without systemd --user). SAFEER_NO_SCOPE=1 disables it.
if [ -z "${SAFEER_NO_SCOPE:-}" ] && command -v systemd-run >/dev/null 2>&1 \
   && systemd-run --user --scope --quiet --collect -p MemoryHigh=60% -- true >/dev/null 2>&1; then
    export SAFEER_NO_SCOPE=1
    exec systemd-run --user --scope --quiet --collect --unit="safeer-browser-$$" \
        -p MemoryHigh=60% -p CPUWeight=80 -- "$BIN_DIR/$(basename "$PRG")" "$@"
fi

# Gladko predvajanje zvoka brez prekinitev (PipeWire / PulseAudio 120ms buffer)
export PULSE_LATENCY_MSEC=120
export GST_PULSE_BUFFER_MS=120

exec "$PY" "$VSTOP" "$@"
