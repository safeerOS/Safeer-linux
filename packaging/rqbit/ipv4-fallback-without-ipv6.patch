+/// Whether the OS refused to create a socket because it has no support for that
+/// address family at all (e.g. IPv6 on Linux booted with `ipv6.disable=1`).
+fn is_address_family_not_supported(e: &std::io::Error) -> bool {
+    #[cfg(unix)]
+    {
+        e.raw_os_error() == Some(nix::errno::Errno::EAFNOSUPPORT as i32)
+    }
+    #[cfg(not(unix))]
+    {
+        let _ = e;
+        false
+    }
+}
+
+fn probe_ipv6_socket() -> std::io::Result<()> {
+    socket2::Socket::new(socket2::Domain::IPV6, socket2::Type::DGRAM, None).map(|_| ())
+}
+
+/// On an OS without IPv6 support every `[::]` bind (TCP listener, DHT, UDP tracker
+/// client, LSD) fails with EAFNOSUPPORT, and the session would not start at all.
+/// In that case behave as if `ipv4_only` was set. If IPv6 sockets can be created,
+/// the options are left untouched.
+fn fallback_to_ipv4_only_if_no_ipv6(
+    opts: &mut SessionOptions,
+    probe: impl FnOnce() -> std::io::Result<()>,
+) {
+    let listen_ipv4_only = opts.listen.as_ref().is_none_or(|l| l.ipv4_only);
+    if opts.ipv4_only && listen_ipv4_only {
+        return;
+    }
+    match probe() {
+        Ok(()) => {}
+        Err(e) if is_address_family_not_supported(&e) => {
+            warn!("IPv6 is not available on this system ({e}), using IPv4 only");
+            opts.ipv4_only = true;
+            if let Some(listen) = opts.listen.as_mut() {
+                listen.ipv4_only = true;
+            }
+        }
+        Err(e) => {
+            debug!("error probing for IPv6 support, assuming it is available: {e:#}");
+        }
+    }
+}
+
 pub(crate) struct CheckedIncomingConnection {
     pub kind: ConnectionKind,
     pub addr: SocketAddr,
