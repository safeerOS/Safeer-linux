                         ..Default::default()
                     })
                     .await
@@ -1833,4 +1882,73 @@ mod tests {
         assert_eq!(parsed.info, generated_parsed.info);
         assert_eq!(parsed_trackers, get_trackers(&generated_parsed));
     }
+
+    #[cfg(unix)]
+    #[test]
+    fn test_fallback_to_ipv4_only_if_no_ipv6() {
+        use super::{SessionOptions, fallback_to_ipv4_only_if_no_ipv6};
+        use crate::listen::ListenerOptions;
+
+        let opts = || SessionOptions {
+            listen: Some(ListenerOptions::default()),
+            ..Default::default()
+        };
+        let ipv4_only = |o: &SessionOptions| (o.ipv4_only, o.listen.as_ref().unwrap().ipv4_only);
+
+        // No IPv6 in the OS (e.g. Linux booted with ipv6.disable=1): IPv4 only everywhere.
+        let mut o = opts();
+        fallback_to_ipv4_only_if_no_ipv6(&mut o, || {
+            Err(std::io::Error::from_raw_os_error(
+                nix::errno::Errno::EAFNOSUPPORT as i32,
+            ))
+        });
+        assert_eq!(ipv4_only(&o), (true, true));
+
+        // IPv6 available: options are left untouched.
+        let mut o = opts();
+        fallback_to_ipv4_only_if_no_ipv6(&mut o, || Ok(()));
+        assert_eq!(ipv4_only(&o), (false, false));
+
+        // Any other error is not a reason to drop IPv6.
+        let mut o = opts();
+        fallback_to_ipv4_only_if_no_ipv6(&mut o, || {
+            Err(std::io::Error::from_raw_os_error(
+                nix::errno::Errno::EMFILE as i32,
+            ))
+        });
+        assert_eq!(ipv4_only(&o), (false, false));
+
+        // Already IPv4 only: no need to probe.
+        let mut o = opts();
+        o.ipv4_only = true;
+        o.listen.as_mut().unwrap().ipv4_only = true;
+        fallback_to_ipv4_only_if_no_ipv6(&mut o, || panic!("should not probe"));
+        assert_eq!(ipv4_only(&o), (true, true));
+    }
+
+    // Default listen address is [::]. On a system without IPv6 the session must still
+    // start (IPv4 only); with IPv6 it keeps listening on [::].
+    #[tokio::test]
+    async fn test_session_starts_with_default_listen_addr() {
+        use super::{Session, SessionOptions, probe_ipv6_socket};
+        use crate::listen::ListenerOptions;
+
+        let dir = tempfile::tempdir().unwrap();
+        let session = Session::new_with_opts(
+            dir.path().into(),
+            SessionOptions {
+                dht: None,
+                persistence: None,
+                disable_local_service_discovery: true,
+                listen: Some(ListenerOptions::default()),
+                ..Default::default()
+            },
+        )
+        .await
+        .unwrap();
+        let addr = session.listen_addr().unwrap();
+        assert_eq!(addr.is_ipv6(), probe_ipv6_socket().is_ok(), "{addr}");
+        assert_eq!(session.ipv4_only, probe_ipv6_socket().is_err());
+        session.stop().await;
+    }
 }
