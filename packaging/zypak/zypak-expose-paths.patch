diff --git a/src/base/launcher.cc b/src/base/launcher.cc
index c1362e2..a74012b 100644
--- a/src/base/launcher.cc
+++ b/src/base/launcher.cc
@@ -118,6 +118,19 @@ bool Launcher::Run(std::vector<std::string> command, const FdMap& fd_map) {
     env[kXdgConfigHomeVar] = Env::Require(kXdgConfigHomeVar);
   }
 
+  // Applications whose Chromium binary is not under /app (e.g. downloaded at runtime into the
+  // app's data directory) need that directory exposed read-only, or the sandboxed children
+  // cannot be executed at all.
+  if (auto paths = Env::Get(Env::kZypakSettingExposePaths); paths && !paths->empty()) {
+    std::vector<std::string> extra_paths;
+    SplitInto(*paths, ":", std::back_inserter(extra_paths), PieceType<std::string>{});
+    for (std::string& path : extra_paths) {
+      if (!path.empty() && access(path.c_str(), F_OK) == 0) {
+        exposed_paths.push_back(std::move(path));
+      }
+    }
+  }
+
   auto helper_path = std::filesystem::path(bindir.ToOwned()) / "zypak-helper";
   Helper helper(helper_path.string(), child_type);
 
