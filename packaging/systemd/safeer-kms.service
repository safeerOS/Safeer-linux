[Unit]
Description=Safeer Link: zajem zaslona KMS (pomocnik s CAP_SYS_ADMIN)
Requires=safeer-kms.socket

[Service]
ExecStart=/usr/bin/python3 -I /usr/lib/safeer/core/link_kms_pomocnik.py
DynamicUser=yes
SupplementaryGroups=video render
AmbientCapabilities=CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_SYS_ADMIN
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-drm rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryDenyWriteExecute=no
# CAP_SYS_ADMIN dovoli mount/umount: brez tega filtra bi proces lahko ponovno priklopil
# datotecni sistem za pisanje in razveljavil ProtectSystem/ProtectHome. Ostalo ffmpeg ne rabi.
SystemCallFilter=~@mount @module @reboot @swap @raw-io @debug @obsolete @cpu-emulation @clock
SystemCallErrorNumber=EPERM
RestrictNamespaces=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
# CAP_SYS_ADMIN dovoli tudi sethostname/setdomainname, bpf (sledenje = branje pomnilnika jedra),
# fanotify, quotactl in kljucavnice jedra (keyctl): nic od tega ffmpeg/kmsgrab ne rabi.
# NEPREVERJENO na ciljnem sistemu: systemd >= 248 (ProtectProc, PrivateIPC), systemd-analyze
# syscall-filter in en zajem po namestitvi. ProcSubset=pid namenoma ni (skrije /proc/cpuinfo,
# ki ga gonilnik VAAPI morda bere).
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
PrivateIPC=yes
SystemCallFilter=~bpf fanotify_init quotactl sethostname setdomainname keyctl add_key request_key
