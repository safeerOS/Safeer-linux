[Icon Theme]
Name=Safeer-Papirus-Dark
Comment=Papirus-Dark with Safeer update status icons (Safeer Cinnamon)
Inherits=Papirus-Dark,breeze-dark,hicolor
Example=folder
Directories=16x16/panel,22x22/panel,24x24/panel,scalable/status

[16x16/panel]
Context=Status
Size=16
Type=Fixed

[22x22/panel]
Context=Status
Size=22
Type=Fixed

[24x24/panel]
Context=Status
Size=24
Type=Fixed

[scalable/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable
