# Tekoci programi na sredini pulta (lastnik, 16. 10. 2026: v postavitvi delovna zeli videti, kaj tece, na sredini
# vrhnjega pulta; vsak program samo na enem mestu - tekoci na pultu, pripeti v docku). Uporabnikov seznam oken s
# pripetimi programi gre se vedno s pulta (seznam_oken: pripeti so v docku), na sredino pa dodamo nov primerek seznama
# brez pripetih programov - kaze samo odprta okna, samo ikone. Okna brez gumba v pultu (delovna povrsina Safeer OS:
# _NET_WM_WINDOW_TYPE_DESKTOP, skip-taskbar) seznam ne kaze. Dodani vnos si zapomnimo: izklop ali druga postavitev
# odstrani samo njega, tudi ce ga je uporabnik premaknil; ce ga je uporabnik odstranil sam, ga ne vracamo.
seznam_sredina() {   # $1 = dodaj | odstrani
    local v izid
    v="$(beri org.cinnamon:enabled-applets)" || return 0
    mkdir -p "$MAPA"
    izid="$(python3 - "$1" "$v" "$(beri org.cinnamon:panels-enabled)" "$SEZNAM_SREDINA" "$SPICES" "$SEZNAM_OKEN" <<'PY'
import ast, json, os, sys
kaj, vrednost, pulti, zapis, spices, skriti = sys.argv[1:7]
UUID, OKNA = "grouped-window-list@cinnamon.org", ("grouped-window-list@cinnamon.org", "window-list@cinnamon.org")
try:
    appleti = [str(a) for a in ast.literal_eval(vrednost.replace("@as ", ""))]
except Exception:
    sys.exit(1)


def deli(a):
    return a.split(":")


def nas(a, st):
    d = deli(a)
    return len(d) >= 5 and d[3] == UUID and d[4] == st


nastavitve = lambda st: os.path.join(spices, UUID, st + ".json")
st_prej = open(zapis, encoding="utf-8").read().strip() if os.path.isfile(zapis) else ""

if kaj == "dodaj":
    if st_prej:
        sys.exit(0)                      # ze dodan (tudi premaknjen ali ga je uporabnik odstranil): ne podvajamo
    if any(len(deli(a)) >= 4 and deli(a)[3] in OKNA for a in appleti):
        sys.exit(0)                      # uporabnikov seznam oken je na pultu: ne dodajamo drugega
    # Pult na vrhu glavnega zaslona (delovna ga je premaknila tja), sicer pult prvega appleta.
    try:
        zgoraj = [deli(p) for p in ast.literal_eval(pulti.replace("@as ", "")) if str(p).endswith(":top")]
    except Exception:
        zgoraj = []
    zgoraj.sort(key=lambda d: (d[1] != "0", d[0]))
    pult = "panel" + zgoraj[0][0] if zgoraj else next((deli(a)[0] for a in appleti if len(deli(a)) >= 4), "panel1")
    sredina = [int(deli(a)[2]) for a in appleti if len(deli(a)) >= 4 and deli(a)[0] == pult and deli(a)[1] == "center"
               and deli(a)[2].isdigit()]
    # Nova stevilka primerka: ne sme se ujemati s skritim seznamom oken (njegove nastavitve cakajo v hrambi) ali s
    # starimi nastavitvami, ki jih je Cinnamon pustil.
    st = [int(deli(a)[4]) for a in appleti if len(deli(a)) >= 5 and deli(a)[4].isdigit()]
    if os.path.isfile(skriti):
        st += [int(deli(a)[4]) for a in open(skriti, encoding="utf-8").read().split() if len(deli(a)) >= 5 and deli(a)[4].isdigit()]
    if os.path.isdir(os.path.join(spices, UUID)):
        st += [int(i[:-5]) for i in os.listdir(os.path.join(spices, UUID)) if i.endswith(".json") and i[:-5].isdigit()]
    nova = str(max(st) + 1 if st else 1)
    # Brez pripetih programov (privzeti Cinnamonovi bi bili nemo, firefox, terminal): Cinnamon ob prvem nalaganju
    # dopolni ostale nastavitve s privzetimi, nase vrednosti (pinned-apps, title-display 1 = samo ikone) pa ohrani
    # (settings.js _doUpgrade, Cinnamon 6.6).
    os.makedirs(os.path.dirname(nastavitve(nova)), exist_ok=True)
    with open(nastavitve(nova), "w", encoding="utf-8") as f:
        json.dump({"pinned-apps": {"type": "generic", "default": [], "value": []},
                   "title-display": {"type": "combobox", "default": 1, "value": 1}}, f)
    with open(zapis, "w", encoding="utf-8") as f:
        f.write(nova + "\n")
    print(repr(appleti + ["%s:center:%d:%s:%s" % (pult, max(sredina) + 1 if sredina else 0, UUID, nova)]))
else:
    if not st_prej:
        sys.exit(0)
    os.remove(zapis)
    try:
        os.remove(nastavitve(st_prej))
    except OSError:
        pass
    ostali = [a for a in appleti if not nas(a, st_prej)]
    if len(ostali) != len(appleti):
        print(repr(ostali))
PY
)" || return 0
    [ -n "$izid" ] && pisi org.cinnamon:enabled-applets "$izid"
    return 0
}

