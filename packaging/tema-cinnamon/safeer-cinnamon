#!/usr/bin/env bash
# ==============================================================================
# Safeer Cinnamon - modra polprosojna tema za Linux Mint Cinnamon (paket safeer-cinnamon).
#
#   safeer-cinnamon --izberi        okno z izbiro postavitve in ozadja (odpre ga "Safeer Cinnamon" v meniju)
#   safeer-cinnamon --profil P [--ozadje O]
#                                   vklopi postavitev P (prejsnje nastavitve si zapomni):
#                                     videz    tema, ikone in ozadje; pult, okna in ikone na namizju ostanejo, kjer so
#                                     dock     videz + pult zgoraj in dock spodaj (odprti programi so v docku)
#                                     delovna  dock + delovna povrsina Safeer OS namesto ikon na namizju; tekoci
#                                              programi na sredini pulta, v docku samo pripeti
#                                   ozadje O: ohrani (kot je zdaj) | prejsnje (kot pred Safeer Cinnamon) |
#                                             jezero | aurora | zora | globina | gore
#   safeer-cinnamon                 vklopi zadnjo izbrano postavitev (prvic: videz)
#   safeer-cinnamon --izklopi       vrne vse, kot je bilo pred vklopom
#   safeer-cinnamon --kontrast      neprosojne povrsine in mocnejse obrobe (lupina in programi)
#   safeer-cinnamon --prosojno      nazaj na obicajni (polprosojni) videz
#   safeer-cinnamon --vecji-tekst [125|150|160|175|200]   vecje besedilo (200 % za ogled od dalec); brez stevilke 125 %
#                                   izpred vklopa   (--obicajen-tekst: nazaj)
#   safeer-cinnamon --stanje        izpise, kaj je vklopljeno
#   safeer-cinnamon --seja          ob prijavi: delovna povrsina Safeer OS (safeer-os --delovna)
#   safeer-cinnamon --nastavitve-docka  odpre nastavitve docka (programe dodas tako, da jih povleces iz menija)
#   safeer-cinnamon --od-vklopa     zagonski in prijavni zaslon v videzu Safeer (vprasa za skrbnisko geslo); ce Safeer
#                                   Cinnamon se ni vklopljen, po prijavi tudi delovna povrsina Safeer OS
#   safeer-cinnamon --od-vklopa-izklopi  vrne prejsnji zagonski in prijavni zaslon (in delovno povrsino, ce jo je vklopil --od-vklopa)
#
# Samo uradne nastavitve Cinnamona (gsettings) in Planka (dconf). V ozadju tecejo le dock Plank in
# Safeer OS (delovna povrsina), ce ju postavitev vkljucuje; --izklopi vrne vse. Zagonski in prijavni zaslon sta
# sistemska (veljata za vse uporabnike), zato ju spremeni samo --od-vklopa s skrbniskim geslom.
# ==============================================================================
set -u

MAPA="${XDG_CONFIG_HOME:-$HOME/.config}/safeer-cinnamon"
PREJ="$MAPA/prej.txt"
AVTO="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
AUTOSTART="$AVTO/safeer-cinnamon-dock.desktop"
SEJA="$AVTO/safeer-cinnamon.desktop"
VKLOPLJENO="$MAPA/vklopljeno"
PROFIL_DAT="$MAPA/profil"
ZADNJE_OZADJE="$MAPA/zadnje-ozadje"
SEZNAM_OKEN="$MAPA/seznam-oken.txt"
SEZNAM_SREDINA="$MAPA/seznam-sredina-dodan"
# Samozagon Safeer OS (cel zaslon) in seja safeer-os-tema bi se tepla z delovno povrsino: med vklopom ju
# izklopimo z uporabnikovim preglasitvenim vnosom in ju ob izklopu vrnemo tocno tako, kot sta bila.
# Samozagon Safeer Control (`safeer-control --ozadje`) tudi: Control tece v procesu delovne povrsine (en proces);
# locen Control, ki se ob prijavi javi prej, bi tekel ves dan kot drugi proces (+67-117 MiB PSS, pregled 15. 10. 2026).
TUJI_ZAGONI="safeer-os.desktop safeer-os-tema.desktop safeer-tema.desktop safeer-control.desktop"
PLANK_TEME="${XDG_DATA_HOME:-$HOME/.local/share}/plank/themes"
# Koren sistema (privzeto /): preizkusi ukaza ga preusmerijo v zacasno mapo.
KOREN="${SAFEER_CINNAMON_KOREN:-}"
SKUPNO="$KOREN/usr/share/safeer-cinnamon"
OZADJA="$KOREN/usr/share/backgrounds/safeer"
TEMA="Safeer-Cinnamon"
KONTRAST="Safeer-Cinnamon-Kontrast"
PLANK_DOCK="/net/launchpad/plank/docks/dock1/"
POMOCNIK="/usr/lib/safeer-cinnamon/od-vklopa"
IZBIRA="/usr/lib/safeer-cinnamon/izbira"
OD_VKLOPA="/var/lib/safeer-cinnamon/od-vklopa.json"
# Nastavitve appletov Cinnamona (pripeti programi seznama oken ...): Cinnamon jih ob odstranitvi appleta izbrise.
SPICES="${XDG_CONFIG_HOME:-$HOME/.config}/cinnamon/spices"

# Kljuci, ki jih vklop spremeni in izklop vrne (shema:kljuc).
KLJUCI="org.cinnamon.desktop.interface:gtk-theme
org.cinnamon.desktop.interface:icon-theme
org.cinnamon.desktop.interface:text-scaling-factor
org.cinnamon.desktop.wm.preferences:theme
org.cinnamon.theme:name
org.cinnamon.desktop.background:picture-uri
org.cinnamon.desktop.background:picture-options
org.cinnamon.desktop.background.slideshow:slideshow-enabled
org.cinnamon:panels-enabled
org.gnome.desktop.interface:gtk-theme
org.gnome.desktop.interface:color-scheme
org.x.apps.portal:color-scheme"

obstaja() { gsettings list-keys "${1%%:*}" 2>/dev/null | grep -qx "${1#*:}"; }
beri() { obstaja "$1" && gsettings get "${1%%:*}" "${1#*:}" 2>/dev/null; }
pisi() { obstaja "$1" && gsettings set "${1%%:*}" "${1#*:}" "$2" >/dev/null 2>&1; return 0; }

zapomni() {
    mkdir -p "$MAPA"
    [ -s "$PREJ" ] && return 0          # ze vklopljeno: ohrani izvirne nastavitve
    : > "$PREJ"
    while IFS= read -r k; do
        v="$(beri "$k")" || continue
        [ -n "$v" ] && printf '%s=%s\n' "$k" "$v" >> "$PREJ"
    done <<< "$KLJUCI"
    if command -v dconf >/dev/null 2>&1; then
        dconf dump "$PLANK_DOCK" > "$MAPA/plank-prej.ini" 2>/dev/null || true
    fi
    # Uporabnik je Plank morda uporabljal ze prej: ob izklopu docka mu ga pustimo teci.
    if pgrep -x plank >/dev/null 2>&1; then : > "$MAPA/plank-je-tekel"; else rm -f "$MAPA/plank-je-tekel"; fi
}

# Izvirna vrednost kljuca (pred vklopom).
vrednost_prej() {
    [ -s "$PREJ" ] || return 1
    local v
    v="$(grep -m1 "^$1=" "$PREJ")" || return 1
    printf '%s\n' "${v#*=}"
}

# Katera postavitev je vklopljena: videz | dock | delovna; prazno = Safeer Cinnamon ni vklopljen.
profil_trenutni() {
    [ -f "$VKLOPLJENO" ] || return 0
    if [ -s "$PROFIL_DAT" ]; then head -n1 "$PROFIL_DAT"; return 0; fi
    # Vklop pred razlicico 1.2 (brez zapisa): po tem, kaj je bilo takrat vklopljeno.
    if [ -f "$SEJA" ]; then echo delovna; elif [ -f "$AUTOSTART" ]; then echo dock; else echo videz; fi
}

# ---------------------------------------------------------------------------- pult in seznam oken
# Pult premakni na vrh, ce je bil spodaj in zgoraj na istem zaslonu se ni pulta (ostali pulti ostanejo).
pult_zgoraj() {
    local v n
    v="$(beri org.cinnamon:panels-enabled)" || return 0
    n="$(python3 - "$v" <<'PY'
import ast, sys
try:
    pulti = [str(p) for p in ast.literal_eval(sys.argv[1].replace("@as ", ""))]
except Exception:
    sys.exit(1)
zgoraj = {p.split(":")[1] for p in pulti if p.endswith(":top") and p.count(":") >= 2}
novi = [p[:-len("bottom")] + "top" if p.endswith(":bottom") and p.count(":") >= 2 and p.split(":")[1] not in zgoraj else p for p in pulti]
print(repr(novi) if novi != pulti else "")
PY
)" || return 0
    [ -n "$n" ] || return 0
    [ -e "$MAPA/pult-prej" ] || printf '%s\n' "$v" > "$MAPA/pult-prej"
    pisi org.cinnamon:panels-enabled "$n"
}

pult_vrni() {
    [ -s "$MAPA/pult-prej" ] || { rm -f "$MAPA/pult-prej"; return 0; }
    pisi org.cinnamon:panels-enabled "$(cat "$MAPA/pult-prej")"
    rm -f "$MAPA/pult-prej"
}

# Vklop pred razlicico 1.2 ni zapisal postavitve, pult je vedno preselil na vrh in seznam oken pustil na njem (dva
# seznama istih oken: pult in dock). Ob prvi prijavi po nadgradnji (ali ob prvi zamenjavi postavitve) zapisemo
# postavitev in lego pulta izpred vklopa ter seznam oken umaknemo s pulta - kot pri novem vklopu.
# $1 = "brez-seznama": seznam oken uredi klicatelj (zamenjava postavitve).
nadgradi_postavitev() {
    [ -f "$VKLOPLJENO" ] || return 0
    [ -s "$PROFIL_DAT" ] && return 0
    local p v
    p="$(profil_trenutni)"
    [ -n "$p" ] || return 0
    printf '%s\n' "$p" > "$PROFIL_DAT"
    [ "$p" = videz ] && return 0
    if [ ! -e "$MAPA/pult-prej" ] && v="$(vrednost_prej org.cinnamon:panels-enabled)"; then printf '%s\n' "$v" > "$MAPA/pult-prej"; fi
    [ "${1:-}" = "brez-seznama" ] && return 0
    seznam_oken_skrij
    dock_dodaj_pripete
    return 0
}

# Dock kaze pripete in odprte programe, zato seznam oken na pultu postane odvec (dva seznama istih oken). Applet
# umaknemo s pulta in si zapomnimo njegov vnos in nastavitve (pripeti programi) - seznam_oken_vrni ga vrne.
seznam_oken() {
    local v izid
    v="$(beri org.cinnamon:enabled-applets)" || return 0
    izid="$(python3 - "$1" "$v" "$SEZNAM_OKEN" "$SPICES" "$MAPA/appleti" "$MAPA/appleti-prej.txt" "$SEZNAM_SREDINA" <<'PY'
import ast, os, shutil, sys
kaj, vrednost, zapis, spices, hramba, prej, sredina = sys.argv[1:8]
OKNA = ("grouped-window-list@cinnamon.org", "window-list@cinnamon.org")
try:
    appleti = [str(a) for a in ast.literal_eval(vrednost.replace("@as ", ""))]
except Exception:
    sys.exit(1)

def deli(a):
    # "panel1:left:2:uuid:stevilka"; privzeta vrednost pred prvim zagonom Cinnamona je brez stevilke.
    d = a.split(":")
    return (d[3], d[4] if len(d) >= 5 else "") if len(d) >= 4 else ("", "")

# Nas seznam tekocih programov na sredini pulta (seznam_sredina) ni uporabnikov: ne skrivamo ga in ne steje kot njegov.
nas = open(sredina, encoding="utf-8").read().strip() if os.path.isfile(sredina) else ""

def je_seznam(a):
    return deli(a)[0] in OKNA and not (nas and deli(a) == (OKNA[0], nas))

if kaj == "skrij":
    okna = [a for a in appleti if je_seznam(a)]
    if not okna:
        sys.exit(0)
    for a in okna:
        uuid, st = deli(a)
        vir = os.path.join(spices, uuid, st + ".json")
        if st and os.path.isfile(vir):
            os.makedirs(os.path.join(hramba, uuid), exist_ok=True)
            shutil.copy2(vir, os.path.join(hramba, uuid, st + ".json"))
    ze = set()
    if os.path.isfile(zapis):
        ze = {v.strip() for v in open(zapis, encoding="utf-8") if v.strip()}
    with open(zapis, "a", encoding="utf-8") as f:
        f.write("".join(a + "\n" for a in okna if a not in ze))
    if not os.path.exists(prej):
        with open(prej, "w", encoding="utf-8") as f:
            f.write(repr(appleti) + "\n")
    print(repr([a for a in appleti if a not in okna]))
else:
    shranjeni = [v.strip() for v in open(zapis, encoding="utf-8") if v.strip()] if os.path.isfile(zapis) else []
    # Uporabnik je seznam oken medtem morda dodal sam: ne podvajamo.
    if not shranjeni or any(je_seznam(a) for a in appleti):
        sys.exit(0)
    for a in shranjeni:
        uuid, st = deli(a)
        vir, cilj = os.path.join(hramba, uuid, st + ".json"), os.path.join(spices, uuid, st + ".json")
        if st and os.path.isfile(vir) and not os.path.exists(cilj):
            os.makedirs(os.path.dirname(cilj), exist_ok=True)
            shutil.copy2(vir, cilj)
    # Ce uporabnik appletov medtem ni spreminjal, vrnemo seznam tocno tak, kot je bil; sicer seznam oken dodamo.
    try:
        izvirni = [str(a) for a in ast.literal_eval(open(prej, encoding="utf-8").read().strip())]
    except Exception:
        izvirni = []
    if izvirni and [a for a in izvirni if a not in shranjeni] == appleti:
        print(repr(izvirni))
    else:
        print(repr(appleti + [a for a in shranjeni if a not in appleti]))
PY
)" || return 0
    [ -n "$izid" ] && pisi org.cinnamon:enabled-applets "$izid"
    return 0
}
# Gumb »Pokaži namizje« v desnem kotu pulta (lastnik, 14. 10. 2026: hitri gumb za prikaz namizja, smiselno uvrscen):
# skrajno desno, za uro - kot v Windows, kotu se ne da zgresiti. Samo pri postavitvah z dockom (dock, delovna), kjer
# namizje Safeer OS nadomesti okna; dodani vnos si zapomnimo, da ga izklop ali videz odstrani - nic drugega ne spreminja.
# Mintov »cornerbar« (tanek trak v kotu, prav tako pokaze namizje) na tem pultu skrijemo (lastnik, 16. 10. 2026: dva
# gumba za isto stvar, obdrzimo samo nasega) - tudi ce je uporabnik nas gumb dodal sam. Tocen vnos, mesto v seznamu in
# nastavitve appleta si zapomnimo; odstrani ga vrne na prejsnje mesto, razen ce ga je uporabnik medtem dodal sam.
pokazi_namizje() {   # $1 = dodaj | odstrani
    local v izid
    v="$(beri org.cinnamon:enabled-applets)" || return 0
    mkdir -p "$MAPA"
    [ "$1" = dodaj ] && : > "$MAPA/pokazi-namizje-ponujeno"
    izid="$(python3 - "$1" "$v" "$MAPA/pokazi-namizje-dodan" "$MAPA/cornerbar-skrit" "$SPICES" "$MAPA/cornerbar-nastavitve" <<'PY'
import ast, os, shutil, sys
kaj, vrednost, zapis, skrit, spices, hramba = sys.argv[1:7]
UUID, KOT = "show-desktop@cinnamon.org", "cornerbar@cinnamon.org"
try:
    appleti = [str(a) for a in ast.literal_eval(vrednost.replace("@as ", ""))]
except Exception:
    sys.exit(1)
zacetni = list(appleti)


def deli(a):
    return a.split(":")


def je(a, uuid):
    return len(deli(a)) >= 4 and deli(a)[3] == uuid


def premakni(seznam, pult, od, za):
    """Desni del pulta: vsem appletom z mestom >= od pristejemo za (1 ali -1)."""
    izid = []
    for a in seznam:
        d = deli(a)
        if len(d) >= 4 and d[0] == pult and d[1] == "right" and d[2].isdigit() and int(d[2]) >= od:
            a = ":".join(d[:2] + [str(int(d[2]) + za)] + d[3:])
        izid.append(a)
    return izid


def nastavitve(a):
    d = deli(a)
    return os.path.join(KOT, d[4] + ".json") if len(d) >= 5 and d[4].isdigit() else None


if kaj == "dodaj":
    # Stevilke instanc pred skrivanjem: nas gumb ne sme dobiti stevilke skritega cornerbarja (ob vrnitvi bi se srecala).
    st = [int(deli(a)[4]) for a in appleti if len(deli(a)) >= 5 and deli(a)[4].isdigit()]
    nas = not any(je(a, UUID) for a in appleti)      # uporabnik ga ze ima (tudi drugje): ne podvajamo
    pult = next((deli(a)[0] for a in appleti if len(deli(a)) >= 4), "panel1")
    pulti = {pult} if nas else {deli(a)[0] for a in appleti if je(a, UUID)}
    zapisani = []
    for a in [a for a in appleti if je(a, KOT) and deli(a)[0] in pulti]:
        i = appleti.index(a)
        zapisani.append("%s\t%d\t%s\n" % (a, i, appleti[i - 1] if i else ""))
        rel = nastavitve(a)
        if rel and os.path.isfile(os.path.join(spices, rel)) and not os.path.exists(os.path.join(hramba, rel)):
            os.makedirs(os.path.dirname(os.path.join(hramba, rel)), exist_ok=True)
            shutil.copy2(os.path.join(spices, rel), os.path.join(hramba, rel))
        del appleti[i]
        d = deli(a)
        if d[1] == "right" and d[2].isdigit():
            appleti = premakni(appleti, d[0], int(d[2]) + 1, -1)     # brez luknje na desnem delu pulta
    # Prvi zapis ostane (ob ponovnem vklopu je cornerbar ze skrit ali ga je uporabnik dodal sam).
    if zapisani and not os.path.exists(skrit):
        with open(skrit, "w", encoding="utf-8") as f:
            f.write("".join(zapisani))
    if nas:                                          # skrajno desno, za vsemi appleti desnega dela pulta
        mesta = [int(deli(a)[2]) for a in appleti if len(deli(a)) >= 4 and deli(a)[0] == pult
                 and deli(a)[1] == "right" and deli(a)[2].isdigit()]
        vnos = "%s:right:%d:%s:%d" % (pult, max(mesta) + 1 if mesta else 0, UUID, max(st) + 1 if st else 1)
        with open(zapis, "w", encoding="utf-8") as f:
            f.write(vnos + "\n")
        appleti.append(vnos)
    if appleti != zacetni:
        print(repr(appleti))
else:
    if os.path.isfile(zapis):
        vnos = open(zapis, encoding="utf-8").read().strip()
        os.remove(zapis)
        d = deli(vnos)
        if vnos in appleti:
            appleti = [a for a in appleti if a != vnos]
            if len(d) >= 3 and d[2].isdigit():
                appleti = premakni(appleti, d[0], int(d[2]) + 1, -1)
    if os.path.isfile(skrit):
        vrstice = [v.rstrip("\n").split("\t") for v in open(skrit, encoding="utf-8") if v.strip()]
        os.remove(skrit)
        for v in reversed(vrstice):
            vnos, i, pred = (v + ["0", ""])[:3]
            d = deli(vnos)
            # Uporabnik je cornerbar na ta pult medtem dodal sam: ne podvajamo.
            if not any(je(a, KOT) and deli(a)[0] == d[0] for a in appleti):
                if len(d) >= 5 and d[4].isdigit() and any(len(deli(a)) >= 5 and deli(a)[4] == d[4] for a in appleti):
                    st = [int(deli(a)[4]) for a in appleti if len(deli(a)) >= 5 and deli(a)[4].isdigit()]
                    d[4] = str(max(st) + 1)       # stevilko je medtem dobil drug applet
                    vnos = ":".join(d)
                if d[1] == "right" and d[2].isdigit():
                    appleti = premakni(appleti, d[0], int(d[2]), 1)
                # Za applet, ki je bil pred njim; ce ga ni vec, na prejsnje mesto v seznamu.
                mesto = appleti.index(pred) + 1 if pred in appleti else min(int(i) if i.isdigit() else 0, len(appleti))
                appleti.insert(mesto, vnos)
                rel, izvor = nastavitve(vnos), nastavitve(v[0])
                if rel and izvor and os.path.isfile(os.path.join(hramba, izvor)) \
                        and not os.path.exists(os.path.join(spices, rel)):
                    os.makedirs(os.path.dirname(os.path.join(spices, rel)), exist_ok=True)
                    shutil.copy2(os.path.join(hramba, izvor), os.path.join(spices, rel))
    shutil.rmtree(hramba, ignore_errors=True)
    if appleti != zacetni:
        print(repr(appleti))
PY
)" || return 0
    [ -n "$izid" ] && pisi org.cinnamon:enabled-applets "$izid"
    return 0
}

# Applet Safeer Miska (lastnik, 14. 10. 2026: ikona baterije v pultu je bila v resnici baterija miske). Na racunalniku
# brez sistemske baterije (namizni PC) nadomesti Mintov applet porabe, ki tam kaze le baterijo miske; na prenosniku
# gre ob njega. Kar dodamo ali odstranimo, si zapomnimo, da izklop vrne pult tocno tak, kot je bil.
miska() {   # $1 = dodaj | odstrani
    local v izid
    [ -d "$KOREN/usr/share/cinnamon/applets/miska@safeer.si" ] || [ -d "$HOME/.local/share/cinnamon/applets/miska@safeer.si" ] \
        || [ "$1" = odstrani ] || return 0
    v="$(beri org.cinnamon:enabled-applets)" || return 0
    mkdir -p "$MAPA"
    if [ "$1" = dodaj ]; then : > "$MAPA/miska-ponujena"; fi
    izid="$(python3 - "$1" "$v" "$MAPA/miska-dodana" "${SAFEER_NAPAJANJE:-/sys/class/power_supply}" <<'PY'
import ast, os, sys
kaj, vrednost, zapis, napajanje = sys.argv[1:5]
UUID, MOC = "miska@safeer.si", "power@cinnamon.org"
try:
    appleti = [str(a) for a in ast.literal_eval(vrednost.replace("@as ", ""))]
except Exception:
    sys.exit(1)


def deli(a):
    return a.split(":")


def sistemska_baterija():
    """Baterija racunalnika (ne miske ali tipkovnice: te imajo scope Device)."""
    try:
        imena = os.listdir(napajanje)
    except OSError:
        return False
    for ime in imena:
        try:
            vrsta = open(os.path.join(napajanje, ime, "type")).read().strip()
        except OSError:
            continue
        try:
            obseg = open(os.path.join(napajanje, ime, "scope")).read().strip()
        except OSError:
            obseg = "System"
        if vrsta == "Battery" and obseg != "Device":
            return True
    return False


if kaj == "dodaj":
    if any(len(deli(a)) >= 4 and deli(a)[3] == UUID for a in appleti):
        sys.exit(0)
    moc = next((a for a in appleti if len(deli(a)) >= 4 and deli(a)[3] == MOC), None)
    st = [int(deli(a)[4]) for a in appleti if len(deli(a)) >= 5 and deli(a)[4].isdigit()]
    if moc is not None:
        d = deli(moc)
        vnos = "%s:%s:%s:%s:%d" % (d[0], d[1], d[2], UUID, max(st) + 1 if st else 1)
        if sistemska_baterija():
            novi = []
            for a in appleti:                      # prenosnik: miska tik pred porabo
                novi += [vnos, a] if a == moc else [a]
            odstranjen = ""
        else:
            novi = [vnos if a == moc else a for a in appleti]
            odstranjen = moc
    else:
        pult = next((deli(a)[0] for a in appleti if len(deli(a)) >= 4), "panel1")
        desno = [int(deli(a)[2]) for a in appleti if len(deli(a)) >= 4 and deli(a)[1] == "right" and deli(a)[2].isdigit()]
        vnos = "%s:right:%d:%s:%d" % (pult, min(desno) if desno else 0, UUID, max(st) + 1 if st else 1)
        novi, odstranjen = appleti + [vnos], ""
    # Zapisa z odstranjenim appletom porabe nikoli ne prepisemo s praznim: sicer --izklopi Mintovega appleta ne vrne
    # vec (ponovno dodana Miska po uporabnikovi odstranitvi - pregled 14. 10. 2026).
    if not odstranjen and os.path.isfile(zapis):
        try:
            odstranjen = (open(zapis, encoding="utf-8").read().split("\n") + ["", ""])[1]
        except OSError:
            pass
    with open(zapis, "w", encoding="utf-8") as f:
        f.write(vnos + "\n" + odstranjen + "\n")
    print(repr(novi))
else:
    if not os.path.isfile(zapis):
        sys.exit(0)
    vrstice = open(zapis, encoding="utf-8").read().split("\n")
