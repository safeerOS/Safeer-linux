#!/usr/bin/env bash
# ==============================================================================
# Safeer Cinnamon - modra polprosojna tema za Linux Mint Cinnamon (paket safeer-cinnamon).
#
#   safeer-cinnamon                 vklopi temo, ozadje, pult zgoraj, dock spodaj in delovno povrsino
#                                   (prejsnje nastavitve si zapomni)
#   safeer-cinnamon --izklopi       vrne vse, kot je bilo pred vklopom
#   safeer-cinnamon --kontrast      neprosojne povrsine in mocnejse obrobe
#   safeer-cinnamon --prosojno      nazaj na obicajni (polprosojni) videz
#   safeer-cinnamon --vecji-tekst   besedilo 125 %   (--obicajen-tekst: nazaj)
#   safeer-cinnamon --stanje        izpise, kaj je vklopljeno
#   safeer-cinnamon --seja          ob prijavi: delovna povrsina Safeer OS (safeer-os --delovna)
#
# Samo uradne nastavitve Cinnamona (gsettings) in Planka (dconf). V ozadju tecejo le dock Plank in
# Safeer OS (delovna povrsina), ce sta namescena; --izklopi vrne vse.
# ==============================================================================
set -u

MAPA="${XDG_CONFIG_HOME:-$HOME/.config}/safeer-cinnamon"
PREJ="$MAPA/prej.txt"
AVTO="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
AUTOSTART="$AVTO/safeer-cinnamon-dock.desktop"
SEJA="$AVTO/safeer-cinnamon.desktop"
VKLOPLJENO="$MAPA/vklopljeno"
# Samozagon Safeer OS (cel zaslon) in seja safeer-os-tema bi se tepla z delovno povrsino: med vklopom ju
# izklopimo z uporabnikovim preglasitvenim vnosom in ju ob izklopu vrnemo tocno tako, kot sta bila.
TUJI_ZAGONI="safeer-os.desktop safeer-os-tema.desktop safeer-tema.desktop"
PLANK_TEME="${XDG_DATA_HOME:-$HOME/.local/share}/plank/themes"
SKUPNO="/usr/share/safeer-cinnamon"
OZADJE="/usr/share/backgrounds/safeer/safeer-gore-3840x2160.png"
TEMA="Safeer-Cinnamon"
KONTRAST="Safeer-Cinnamon-Kontrast"
PLANK_DOCK="/net/launchpad/plank/docks/dock1/"

# Kljuci, ki jih vklop spremeni in izklop vrne (shema:kljuc).
KLJUCI="org.cinnamon.desktop.interface:gtk-theme
org.cinnamon.desktop.interface:icon-theme
org.cinnamon.desktop.interface:text-scaling-factor
org.cinnamon.desktop.wm.preferences:theme
org.cinnamon.theme:name
org.cinnamon.desktop.background:picture-uri
org.cinnamon.desktop.background:picture-options
org.cinnamon:panels-enabled
org.gnome.desktop.interface:gtk-theme
org.gnome.desktop.interface:color-scheme"

obstaja() { gsettings list-keys "${1%%:*}" 2>/dev/null | grep -qx "${1#*:}"; }
beri() { obstaja "$1" && gsettings get "${1%%:*}" "${1#*:}" 2>/dev/null; }
pisi() { obstaja "$1" && gsettings set "${1%%:*}" "${1#*:}" "$2" >/dev/null 2>&1; return 0; }

zapomni() {
    mkdir -p "$MAPA"
    [ -s "$PREJ" ] && return 0          # ze vklopljeno: ohrani izvirne nastavitve
    : > "$PREJ"
    while IFS= read -r k; do
        v="$(beri "$k")" || continue
        [ -n "$v" ] && printf '%s=%s\n' "$k" "$v" >> "$PREJ"
    done <<< "$KLJUCI"
    if command -v dconf >/dev/null 2>&1; then
        dconf dump "$PLANK_DOCK" > "$MAPA/plank-prej.ini" 2>/dev/null || true
    fi
}

# Pult premakni na vrh, ce je bil spodaj (ohrani vse ostale pulte in zaslone).
pult_zgoraj() {
    local v
    v="$(beri org.cinnamon:panels-enabled)" || return 0
    case "$v" in *":bottom"*) pisi org.cinnamon:panels-enabled "${v//:bottom/:top}" ;; esac
}

# Plank si ob zagonu zapomni velikost zaslona in se na kasnejso spremembo lodljivosti ne odzove
# (na TV je po prijavi 1920x1080 preskocil na 2560x1440: dock je ostal na sredini in rezerviral napacen
# rob). Zato ga zazenemo sele, ko je velikost zaslona 3 s enaka, in znova ob vsaki spremembi zaslona
# (to sprozi delovna povrsina Safeer OS).
dock_zazeni() {
    command -v plank >/dev/null 2>&1 || return 0
    local prej="" zdaj stabilno=0 i
    for i in $(seq 1 20); do
        zdaj="$(xrandr --current 2>/dev/null | sed -n 's/.*current \([0-9]* x [0-9]*\).*/\1/p')"
        if [ -n "$zdaj" ] && [ "$zdaj" = "$prej" ]; then stabilno=$((stabilno + 1)); else stabilno=0; fi
        prej="$zdaj"
        [ "$stabilno" -ge 3 ] && break
        sleep 1
    done
    pkill -x plank >/dev/null 2>&1 && sleep 0.5
    (setsid plank >/dev/null 2>&1 &)
}

dock() {
    command -v plank >/dev/null 2>&1 || { echo "safeer-cinnamon: Plank ni namescen - dock preskocen (sudo apt install plank)."; return 0; }
    mkdir -p "$PLANK_TEME/$TEMA"
    cp -f "$SKUPNO/plank/dock.theme" "$PLANK_TEME/$TEMA/dock.theme"
    if command -v dconf >/dev/null 2>&1; then
        dconf write "${PLANK_DOCK}theme" "'$TEMA'"
        dconf write "${PLANK_DOCK}position" "'bottom'"
        dconf write "${PLANK_DOCK}alignment" "'center'"
        # 'none' = dock je vedno viden in si rezervira prostor: okna ga ne prekrijejo.
        dconf write "${PLANK_DOCK}hide-mode" "'none'"
        dconf write "${PLANK_DOCK}icon-size" "40"
        dconf write "${PLANK_DOCK}zoom-enabled" "false"
    fi
    mkdir -p "$(dirname "$AUTOSTART")"
    printf '[Desktop Entry]\nType=Application\nName=Safeer Cinnamon dock\nExec=safeer-cinnamon --dock\nX-GNOME-Autostart-enabled=true\nNoDisplay=true\n' > "$AUTOSTART"
    pgrep -x plank >/dev/null 2>&1 || dock_zazeni
}

zagoni_izklopi() {
    local ime
    mkdir -p "$AVTO" "$MAPA/zagoni"
    for ime in $TUJI_ZAGONI; do
        [ -e "$MAPA/zagoni/$ime" ] || [ -e "$MAPA/zagoni/$ime.ni" ] && continue
        if [ -f "$AVTO/$ime" ]; then cp -p "$AVTO/$ime" "$MAPA/zagoni/$ime"; else : > "$MAPA/zagoni/$ime.ni"; fi
        printf '[Desktop Entry]\nType=Application\nName=%s\nHidden=true\nX-GNOME-Autostart-enabled=false\n' "$ime" > "$AVTO/$ime"
    done
}

zagoni_vrni() {
    local ime
    for ime in $TUJI_ZAGONI; do
        if [ -f "$MAPA/zagoni/$ime" ]; then mv -f "$MAPA/zagoni/$ime" "$AVTO/$ime"
        elif [ -e "$MAPA/zagoni/$ime.ni" ]; then rm -f "$AVTO/$ime" "$MAPA/zagoni/$ime.ni"; fi
    done
}

delovna() {
    # Delovna povrsina (iskanje, datoteke, predvajalnik, programi naprav) je del Safeer OS.
    command -v safeer-os >/dev/null 2>&1 || { echo "safeer-cinnamon: Safeer OS ni namescen - delovna povrsina preskocena."; return 0; }
    zagoni_izklopi
    printf '[Desktop Entry]\nType=Application\nName=Safeer Cinnamon\nExec=safeer-cinnamon --seja\nX-GNOME-Autostart-enabled=true\nX-GNOME-Autostart-Delay=2\nNoDisplay=true\n' > "$SEJA"
    pgrep -f "safeer_os.py|/safeer-os( |$)" >/dev/null 2>&1 || (setsid safeer-os --delovna >/dev/null 2>&1 &)
}

vklopi() {
    zapomni
    : > "$VKLOPLJENO"
    pisi org.cinnamon.desktop.interface:gtk-theme "'$TEMA'"
    pisi org.gnome.desktop.interface:gtk-theme "'$TEMA'"
    pisi org.gnome.desktop.interface:color-scheme "'prefer-dark'"
    pisi org.cinnamon.desktop.wm.preferences:theme "'$TEMA'"
    pisi org.cinnamon.theme:name "'$TEMA'"
    [ -d /usr/share/icons/Papirus-Dark ] && pisi org.cinnamon.desktop.interface:icon-theme "'Papirus-Dark'"
    if [ -f "$OZADJE" ]; then
        pisi org.cinnamon.desktop.background:picture-uri "'file://$OZADJE'"
        pisi org.cinnamon.desktop.background:picture-options "'zoom'"
    fi
    pult_zgoraj
    dock
    delovna
}

izklopi() {
    if [ -s "$PREJ" ]; then
        while IFS= read -r vrstica; do
            [ -n "$vrstica" ] && pisi "${vrstica%%=*}" "${vrstica#*=}"
        done < "$PREJ"
        rm -f "$PREJ"
    fi
    rm -f "$AUTOSTART" "$SEJA" "$VKLOPLJENO"
    zagoni_vrni
    rmdir "$MAPA/zagoni" 2>/dev/null || true
    # Delovna povrsina (Safeer OS z --delovna) se konca cisto (SIGTERM -> Safeer OS pospravi za sabo).
    pkill -TERM -f "safeer.*--delovna" >/dev/null 2>&1 || true
    pkill -x plank >/dev/null 2>&1 || true
    if command -v dconf >/dev/null 2>&1 && [ -f "$MAPA/plank-prej.ini" ]; then
        dconf reset -f "$PLANK_DOCK" 2>/dev/null || true
        dconf load "$PLANK_DOCK" < "$MAPA/plank-prej.ini" 2>/dev/null || true
        rm -f "$MAPA/plank-prej.ini"
    fi
    rm -rf "$PLANK_TEME/$TEMA"
}

stanje() {
    echo "tema lupine:  $(beri org.cinnamon.theme:name)"
    echo "GTK:          $(beri org.cinnamon.desktop.interface:gtk-theme)"
    echo "tekst:        $(beri org.cinnamon.desktop.interface:text-scaling-factor)"
    echo "pulti:        $(beri org.cinnamon:panels-enabled)"
    echo "dock:         $( [ -f "$AUTOSTART" ] && echo vklopljen || echo izklopljen)"
    echo "delovna:      $( [ -f "$SEJA" ] && echo "ob prijavi (safeer-os --delovna)" || echo izklopljena)"
    echo "zapomnjeno:   $( [ -s "$PREJ" ] && echo "da ($PREJ)" || echo ne)"
}

case "${1:-}" in
    ""|--vklopi|--on)        vklopi ;;
    --izklopi|--off)         izklopi ;;
    --kontrast)              zapomni; pisi org.cinnamon.theme:name "'$KONTRAST'" ;;
    --prosojno)              pisi org.cinnamon.theme:name "'$TEMA'" ;;
    --vecji-tekst)           zapomni; pisi org.cinnamon.desktop.interface:text-scaling-factor "1.25" ;;
    --obicajen-tekst)        pisi org.cinnamon.desktop.interface:text-scaling-factor "1.0" ;;
    --stanje|--status)       stanje ;;
    --dock)                  [ -f "$VKLOPLJENO" ] && dock_zazeni ;;
    --seja)                  [ -f "$VKLOPLJENO" ] && command -v safeer-os >/dev/null 2>&1 && exec safeer-os --delovna ;;
    -h|--help)               sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) echo "safeer-cinnamon: neznana moznost $1 (--help)" >&2; exit 2 ;;
esac
