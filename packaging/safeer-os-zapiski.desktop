[Desktop Entry]
Type=Application
Name=Notes
Name[sl]=Zapiski
Name[de]=Notizen
Name[es]=Notas
Name[fr]=Notes
Name[it]=Note
Comment=Notes in Safeer OS
Comment[sl]=Zapiski v Safeer OS
Comment[de]=Notizen in Safeer OS
Comment[es]=Notas en Safeer OS
Comment[fr]=Notes dans Safeer OS
Comment[it]=Note in Safeer OS
Exec=safeer-os --razdelek zapiski
Icon=safeer-os.zapiski
