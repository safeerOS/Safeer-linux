+                        g_test_message ("policy %s uri %s enforced=%d starting=%d", policies[p], uris[i], enforced, starting);
+                        g_assert_true (enforced);
+                        g_assert_false (starting);
+                        g_assert_null (body);
+                        g_clear_error (&error);
+                        g_object_unref (msg);
+                        g_object_unref (cancellable);
+                        soup_test_session_abort_unref (session);
+                        g_object_unref (enforcer);
