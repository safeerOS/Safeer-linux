From: Safeer team <info@safeer.si>
Subject: [PATCH] cookies, hsts, session: IP host cookie matching, trailing-dot host names, Cookie on cross-origin redirect

See README.md for the description, reproducers and measurements.
---
diff --git a/libsoup/cookies/soup-cookie-jar.c b/libsoup/cookies/soup-cookie-jar.c
index f611e34..b0134c0 100644
--- a/libsoup/cookies/soup-cookie-jar.c
+++ b/libsoup/cookies/soup-cookie-jar.c
@@ -371,7 +371,8 @@ get_cookies (SoupCookieJar *jar,
 				g_hash_table_insert (priv->domains,
 						     g_strdup (cur),
 						     new_head);
-			} else if (soup_cookie_applies_to_uri (cookie, uri) &&
+			} else if (soup_cookie_domain_matches (cookie, host) &&
+			           soup_cookie_applies_to_uri (cookie, uri) &&
 			           cookie_is_valid_for_same_site_policy (cookie, is_safe_method, uri, top_level,
 				                                         site_for_cookies, is_top_level_navigation,
 									 for_http) &&
diff --git a/libsoup/cookies/soup-cookie.c b/libsoup/cookies/soup-cookie.c
index ca9b7e2..64a78eb 100644
--- a/libsoup/cookies/soup-cookie.c
+++ b/libsoup/cookies/soup-cookie.c
@@ -87,6 +87,37 @@ soup_cookie_copy (SoupCookie *cookie)
 	return copy;
 }
 
+/* An IP address, or a host that resolvers treat as one: the last label is numeric, as in
+ * "1.2.772", "1.2.3.04", "0x7f.1" or "1.2.3.4." (WHATWG URL ends-in-a-number rule). */
+static gboolean
+host_is_ip_like (const char *host)
+{
+	gsize len = strlen (host);
+	const char *last, *end, *p;
+
+	if (g_hostname_is_ip_address (host))
+		return TRUE;
+	while (len > 0 && host[len - 1] == '.')
+		len--;
+	if (!len)
+		return FALSE;
+	end = host + len;
+	last = g_strrstr_len (host, len, ".");
+	last = last ? last + 1 : host;
+	if (end - last >= 2 && last[0] == '0' && (last[1] == 'x' || last[1] == 'X')) {
+		for (p = last + 2; p < end; p++) {
+			if (!g_ascii_isxdigit (*p))
+				return FALSE;
+		}
+		return TRUE;
+	}
+	for (p = last; p < end; p++) {
+		if (!g_ascii_isdigit (*p))
+			return FALSE;
+	}
+	return TRUE;
+}
+
 /**
  * soup_cookie_domain_matches:
  * @cookie: a #SoupCookie
@@ -105,6 +136,20 @@ soup_cookie_domain_matches (SoupCookie *cookie, const char *host)
 	g_return_val_if_fail (cookie != NULL, FALSE);
 	g_return_val_if_fail (host != NULL, FALSE);
 
+	/* A cookie without a domain matches no host (soup_cookie_set_domain() accepts NULL). */
+	if (!cookie->domain)
+		return FALSE;
+
+	/* RFC 6265, 5.1.3: domain-match by suffix applies only to host names. A cookie for an IP
+	 * address must match that exact address, otherwise "Domain=3.4" set by 1.2.3.4 would be sent to 7.7.3.4. */
+	if (host_is_ip_like (host)) {
+		const char *domain = cookie->domain;
+
+		if (*domain == '.')
+			domain++;
+		return !g_ascii_strcasecmp (domain, host);
+	}
+
 	return soup_host_matches_host (cookie->domain, host);
 }
 
