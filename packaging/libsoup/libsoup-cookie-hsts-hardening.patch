+/* The public suffix list is lower case and knows "co.uk", not "CO.UK" and not "co.uk.", but all three name the same
+ * domain: "Domain=CO.UK" or "Domain=co.uk." set by http://evil.co.uk/ must not slip past the check and be sent to every
+ * host under co.uk. */
+static gboolean
+cookie_domain_is_public_suffix (const char *domain)
+{
+	gsize len = strlen (domain);
+	const char *labels;
+	char *normalized;
+	gboolean retval;
+
+	while (len > 1 && domain[len - 1] == '.')
+		len--;
+	normalized = g_ascii_strdown (domain, len);
+
+	/* g_ascii_strdown() leaves upper case letters of other scripts (Cyrillic, Greek ...) as they are, and the list
+	 * knows the names in lower case only: a name that is valid UTF-8 is lower-cased as a whole (one that is not is
+	 * left alone). */
+	if (!g_str_is_ascii (normalized) && g_utf8_validate (normalized, -1, NULL)) {
+		char *lowered = g_utf8_strdown (normalized, -1);
+
+		g_free (normalized);
+		normalized = lowered;
+	}
+
+	/* A name with an empty label ("..co.uk", "x..co.uk", "..") names no host and the public suffix list does not
+	 * know it: a cookie for it could only be a way past the check below, so it is never accepted. */
+	labels = normalized[0] == '.' ? normalized + 1 : normalized;
+	if (len > 0 && (!*labels || *labels == '.' || strstr (labels, ".."))) {
+		g_free (normalized);
+		return TRUE;
+	}
+
+	retval = soup_tld_domain_is_public_suffix (normalized);
+	g_free (normalized);
+	return retval;
+}
