+
+	/* The Cyrillic suffix of Serbian organisations is a public suffix in upper and in lower case. */
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=\xd0\x9e\xd0\xa0\xd0\x93.\xd0\xa1\xd0\xa0\xd0\x91");
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=\xd0\xbe\xd1\x80\xd0\xb3.\xd1\x81\xd1\x80\xd0\xb1");
+	soup_cookie_jar_add_cookie (jar, soup_cookie_new ("x", "1", ".\xd0\x9e\xd0\xa0\xd0\x93.\xd0\xa1\xd0\xa0\xd0\x91", "/", -1));
+	g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+	cookies = soup_cookie_jar_get_cookies (jar, victim, TRUE);
+	g_assert_null (cookies);
