+/* An IP address, or a host that resolvers treat as one: the last label is numeric, as in
+ * "1.2.772", "1.2.3.04", "0x7f.1" or "1.2.3.4." (WHATWG URL ends-in-a-number rule). */
+static gboolean
+host_is_ip_like (const char *host)
+{
+	gsize len = strlen (host);
+	const char *last, *end, *p;
+
+	if (g_hostname_is_ip_address (host))
+		return TRUE;
+	while (len > 0 && host[len - 1] == '.')
+		len--;
+	if (!len)
+		return FALSE;
+	end = host + len;
+	last = g_strrstr_len (host, len, ".");
+	last = last ? last + 1 : host;
+	if (end - last >= 2 && last[0] == '0' && (last[1] == 'x' || last[1] == 'X')) {
+		for (p = last + 2; p < end; p++) {
+			if (!g_ascii_isxdigit (*p))
+				return FALSE;
+		}
+		return TRUE;
+	}
+	for (p = last; p < end; p++) {
+		if (!g_ascii_isdigit (*p))
+			return FALSE;
+	}
+	return TRUE;
+}
