+do_cookies_ip_host_test (void)
+{
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *setter = g_uri_parse ("http://1.2.3.4/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *other = g_uri_parse ("http://7.7.3.4/", SOUP_HTTP_URI_FLAGS, NULL);
+	SoupCookie *cookie;
+	char *cookies;
+
+	/* RFC 6265 5.1.3: an IP address host only domain-matches itself. */
+	soup_cookie_jar_set_cookie (jar, setter, "suffix=1; Domain=3.4");
+	soup_cookie_jar_set_cookie (jar, setter, "exact=1");
+	cookies = soup_cookie_jar_get_cookies (jar, other, TRUE);
+	g_assert_null (cookies);
+	cookies = soup_cookie_jar_get_cookies (jar, setter, TRUE);
+	g_assert_cmpstr (cookies, ==, "exact=1");
+	g_free (cookies);
+
+	/* A cookie that is already in the jar (persistent storage, soup_cookie_jar_add_cookie())
+	 * must not be sent to another IP address either. */
+	soup_cookie_jar_add_cookie (jar, soup_cookie_new ("stored", "1", ".3.4", "/", -1));
+	cookies = soup_cookie_jar_get_cookies (jar, other, TRUE);
+	g_assert_null (cookies);
+
+	/* No domain at all never matches, for an IP address or a host name (no g_critical). */
+	cookie = soup_cookie_new ("x", "1", "1.2.3.4", "/", -1);
+	soup_cookie_set_domain (cookie, NULL);
+	g_assert_false (soup_cookie_domain_matches (cookie, "1.2.3.4"));
+	g_assert_false (soup_cookie_domain_matches (cookie, "example.com"));
+	soup_cookie_free (cookie);
+
+	/* Hosts that resolvers treat as IPv4 addresses (shorthand, octal, hex, trailing dot)
+	 * follow the same exact-match rule. */
+	cookie = soup_cookie_new ("y", "1", ".2.772", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "9.2.772"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".3.04", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "1.2.3.04"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".7.0x", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "9.7.0x"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".0x1", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "7.0x1"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".3.4.", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "7.7.3.4."));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", "1.2.772", "/", -1);
+	g_assert_true (soup_cookie_domain_matches (cookie, "1.2.772"));
+	soup_cookie_free (cookie);
+	/* A host name is unchanged: suffix matching still applies. */
+	cookie = soup_cookie_new ("z", "1", ".example.com", "/", -1);
+	g_assert_true (soup_cookie_domain_matches (cookie, "www.example.com"));
+	soup_cookie_free (cookie);
+
+	g_uri_unref (setter);
+	g_uri_unref (other);
+	g_object_unref (jar);
+}
+
+static void
+do_cookies_host_case_test (void)
+{
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *setter = g_uri_parse ("http://www.example.com/", SOUP_HTTP_URI_FLAGS, NULL);
+	SoupCookie *cookie;
+	const char *hosts[] = { "http://WWW.EXAMPLE.COM/", "http://www.Example.com/", "http://Www.example.com/",
+				"http://EXAMPLE.COM/", "http://SUB.www.example.com/", NULL };
+	int i;
+
+	/* Host names are case-insensitive: a cookie for example.com is sent to WWW.EXAMPLE.COM too
+	 * (an application that does not lower-case the host itself). */
+	soup_cookie_jar_set_cookie (jar, setter, "k=v; Domain=example.com");
+	for (i = 0; hosts[i]; i++) {
+		GUri *uri = g_uri_parse (hosts[i], SOUP_HTTP_URI_FLAGS, NULL);
+		char *cookies = soup_cookie_jar_get_cookies (jar, uri, TRUE);
+
+		g_assert_cmpstr (cookies, ==, "k=v");
+		g_free (cookies);
+		g_uri_unref (uri);
+	}
+
+	cookie = soup_cookie_new ("y", "1", ".example.com", "/", -1);
+	g_assert_true (soup_cookie_domain_matches (cookie, "WWW.EXAMPLE.COM"));
+	g_assert_true (soup_cookie_domain_matches (cookie, "www.Example.com"));
+	g_assert_false (soup_cookie_domain_matches (cookie, "WWW.EXAMPLE.ORG"));
+	g_assert_false (soup_cookie_domain_matches (cookie, "NOTEXAMPLE.COM"));
+	soup_cookie_free (cookie);
+
+	g_uri_unref (setter);
+	g_object_unref (jar);
+}
+
+static void
+do_cookies_public_suffix_trailing_dot_test (void)
+{
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *evil = g_uri_parse ("http://evil.co.uk./", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *victim = g_uri_parse ("http://victim.co.uk./", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *victim_plain = g_uri_parse ("http://victim.co.uk/", SOUP_HTTP_URI_FLAGS, NULL);
+	GSList *all;
+	char *cookies;
+
+	/* "co.uk." is the public suffix "co.uk": no site may set a cookie for it, with or without the
+	 * trailing dot of the host name. */
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=co.uk.");
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=co.uk..");
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=co.uk");
+	all = soup_cookie_jar_all_cookies (jar);
+	g_assert_null (all);
+	cookies = soup_cookie_jar_get_cookies (jar, victim, TRUE);
+	g_assert_null (cookies);
+	cookies = soup_cookie_jar_get_cookies (jar, victim_plain, TRUE);
+	g_assert_null (cookies);
+
+	/* A cookie for the site itself is still accepted. */
+	soup_cookie_jar_set_cookie (jar, evil, "ok=1");
+	cookies = soup_cookie_jar_get_cookies (jar, evil, TRUE);
+	g_assert_cmpstr (cookies, ==, "ok=1");
+	g_free (cookies);
+
+	g_uri_unref (evil);
+	g_uri_unref (victim);
+	g_uri_unref (victim_plain);
+	g_object_unref (jar);
+}
+
+static guint
+seen_requests_count (void)
+{
+	guint n;
+
+	g_mutex_lock (&seen_lock);
+	n = seen_requests ? seen_requests->len : 0;
+	g_mutex_unlock (&seen_lock);
+	return n;
+}
+
+/* "(none)" or the Cookie header of the last request the server received for @host; NULL if there was none. */
+static char *
+seen_request_cookie (const char *host)
+{
+	char *prefix = g_strdup_printf ("%s|", host);
+	char *result = NULL;
+	guint i;
+
+	g_mutex_lock (&seen_lock);
+	for (i = seen_requests ? seen_requests->len : 0; i > 0; i--) {
+		const char *entry = g_ptr_array_index (seen_requests, i - 1);
+
+		if (g_str_has_prefix (entry, prefix)) {
+			result = g_strdup (entry + strlen (prefix));
+			break;
+		}
+	}
+	g_mutex_unlock (&seen_lock);
+	g_free (prefix);
+	return result;
+}
+
+/* A session that sends every request to the test server as to an HTTP proxy, so that a request can name any host
+ * (evil.co.uk, victim.github.io ...) and the cookie jar sees exactly that host. */
+static SoupSession *
+proxied_session (SoupCookieJarAcceptPolicy policy, SoupCookieJar **jar)
+{
+	char *proxy = g_uri_to_string (first_party_uri);
+	GProxyResolver *resolver = g_simple_proxy_resolver_new (proxy, NULL);
+	SoupSession *session = soup_test_session_new ("proxy-resolver", resolver, NULL);
+
+	g_object_unref (resolver);
+	g_free (proxy);
+	soup_session_add_feature_by_type (session, SOUP_TYPE_COOKIE_JAR);
+	*jar = SOUP_COOKIE_JAR (soup_session_get_feature (session, SOUP_TYPE_COOKIE_JAR));
+	soup_cookie_jar_set_accept_policy (*jar, policy);
+	return session;
+}
+
+/* GET http://@host/ through the proxy. @set_cookie becomes the Set-Cookie header of the response, @first_party the
+ * first party of the request. Asserts that the server really received the request. */
+static void
+proxied_get (SoupSession *session, const char *host, const char *set_cookie, const char *first_party)
+{
+	char *url = g_strdup_printf ("http://%s:%d/x", host, g_uri_get_port (first_party_uri));
+	GUri *uri = g_uri_parse (url, SOUP_HTTP_URI_FLAGS, NULL);
+	SoupMessage *msg;
+	guint before = seen_requests_count ();
+
+	g_assert_nonnull (uri);
+	msg = soup_message_new_from_uri ("GET", uri);
+	if (set_cookie)
+		soup_message_headers_replace (soup_message_get_request_headers (msg), "Echo-Set-Cookie", set_cookie);
+	if (first_party) {
+		GUri *first = g_uri_parse (first_party, SOUP_HTTP_URI_FLAGS, NULL);
+
+		soup_message_set_first_party (msg, first);
+		soup_message_set_site_for_cookies (msg, first);
+		g_uri_unref (first);
+	}
+	soup_test_session_send_message (session, msg);
+	soup_test_assert_message_status (msg, SOUP_STATUS_OK);
+	/* The request reached the server: without this a rejected cookie would prove nothing. */
+	g_assert_cmpuint (seen_requests_count (), ==, before + 1);
+
+	g_object_unref (msg);
+	g_uri_unref (uri);
+	g_free (url);
+}
+
+static void
+assert_server_saw_cookie (const char *host, const char *expected)
+{
+	char *cookie = seen_request_cookie (host);
+
+	g_assert_cmpstr (cookie, ==, expected);
+	g_free (cookie);
+}
+
+static guint
+jar_cookie_count (SoupCookieJar *jar)
+{
+	GSList *all = soup_cookie_jar_all_cookies (jar);
+	guint n = g_slist_length (all);
+
+	g_slist_free_full (all, (GDestroyNotify) soup_cookie_free);
+	return n;
+}
+
+typedef struct {
+	const char *setter;
+	const char *set_cookie;
+	const char *first_party;
+	SoupCookieJarAcceptPolicy policy;
+	const char *victim;
+} PublicSuffixCaseTest;
+
+static const PublicSuffixCaseTest public_suffix_rejected_tests[] = {
+	/* The public suffix list is lower case: "CO.UK" is the public suffix "co.uk" all the same. */
+	{ "evil.co.uk", "x=1; Domain=CO.UK", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.co.uk" },
+	{ "evil.co.uk", "x=1; Domain=Co.Uk", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.co.uk" },
+	{ "evil.co.uk", "x=1; Domain=.CO.UK", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.co.uk" },
+	{ "evil.co.uk", "x=1; Domain=.CO.UK.", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.co.uk" },
+	{ "evil.co.uk.", "x=1; Domain=CO.UK.", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.co.uk." },
+	{ "evil.github.io", "x=1; Domain=GITHUB.IO", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.github.io" },
+	{ "evil.github.io", "x=1; Domain=.GitHub.Io", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "victim.github.io" },
+	/* The policies that reject third parties must not take the upper case suffix for "the same site". */
+	{ "tracker.evil.co.uk", "x=1; Domain=CO.UK", "http://site.co.uk/", SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY, "site.co.uk" },
+	{ "tracker.evil.co.uk", "x=1; Domain=.Co.Uk.", "http://site.co.uk/", SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY, "site.co.uk" },
+	{ "evil.github.io", "x=1; Domain=GITHUB.IO", "http://victim.github.io/", SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY, "victim.github.io" },
+	{ "evil.github.io", "x=1; Domain=GITHUB.IO", "http://victim.github.io/", SOUP_COOKIE_JAR_ACCEPT_GRANDFATHERED_THIRD_PARTY, "victim.github.io" },
+	{ "evil.co.uk", "x=1; Domain=CO.UK", "http://evil.co.uk/", SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY, "victim.co.uk" },
+};
