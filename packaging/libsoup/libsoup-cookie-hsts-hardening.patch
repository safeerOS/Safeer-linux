diff --git a/libsoup/hsts/soup-hsts-enforcer.c b/libsoup/hsts/soup-hsts-enforcer.c
index fe2cc9d..06f79bf 100644
--- a/libsoup/hsts/soup-hsts-enforcer.c
+++ b/libsoup/hsts/soup-hsts-enforcer.c
@@ -413,33 +413,63 @@ super_domain_of (const char *domain)
 	return iter;
 }
 
-static gboolean
-soup_hsts_enforcer_must_enforce_secure_transport (SoupHSTSEnforcer *hsts_enforcer,
-						  const char *domain)
+/* "example.com." (and "example.com..") name the same host as "example.com". Returns a copy
+ * without the trailing dots, or NULL when @domain has none (or would become empty). */
+static char *
+domain_without_trailing_dots (const char *domain)
 {
-        SoupHSTSEnforcerPrivate *priv = soup_hsts_enforcer_get_instance_private (hsts_enforcer);
-	const char *super_domain = domain;
+	gsize len = strlen (domain);
 
-	g_return_val_if_fail (domain != NULL, FALSE);
+	if (len < 2 || domain[len - 1] != '.')
+		return NULL;
+	while (len > 0 && domain[len - 1] == '.')
+		len--;
+	return len ? g_strndup (domain, len) : NULL;
+}
 
-        g_mutex_lock (&priv->mutex);
+/* The policy of @domain itself, or of a parent domain with includeSubDomains. Called with the lock held. */
+static gboolean
+policy_applies (SoupHSTSEnforcer *hsts_enforcer,
+		const char *domain)
+{
+	const char *super_domain = domain;
 
-	if (soup_hsts_enforcer_has_valid_policy (hsts_enforcer, domain)) {
-                g_mutex_unlock (&priv->mutex);
+	if (soup_hsts_enforcer_has_valid_policy (hsts_enforcer, domain))
 		return TRUE;
-        }
 
 	while ((super_domain = super_domain_of (super_domain)) != NULL) {
 		if (soup_hsts_enforcer_host_includes_subdomains (hsts_enforcer, super_domain) &&
-		    soup_hsts_enforcer_has_valid_policy (hsts_enforcer, super_domain)) {
-                        g_mutex_unlock (&priv->mutex);
+		    soup_hsts_enforcer_has_valid_policy (hsts_enforcer, super_domain))
 			return TRUE;
-                }
 	}
 
+	return FALSE;
+}
+
+static gboolean
+soup_hsts_enforcer_must_enforce_secure_transport (SoupHSTSEnforcer *hsts_enforcer,
+						  const char *domain)
+{
+        SoupHSTSEnforcerPrivate *priv = soup_hsts_enforcer_get_instance_private (hsts_enforcer);
+	char *without_dot;
+	gboolean retval;
+
+	g_return_val_if_fail (domain != NULL, FALSE);
+
+	/* Without this a request for http://example.com./ would avoid the policy for example.com. */
+	without_dot = domain_without_trailing_dots (domain);
+
+        g_mutex_lock (&priv->mutex);
+
+	/* The name without trailing dots first; then, as before this change, the name as written, so a policy
+	 * stored under a dotted name (also a parent with includeSubDomains) keeps applying. */
+	retval = policy_applies (hsts_enforcer, without_dot ? without_dot : domain) ||
+		 (without_dot && policy_applies (hsts_enforcer, domain));
+
         g_mutex_unlock (&priv->mutex);
+	g_free (without_dot);
 
-	return FALSE;
+	return retval;
 }
 
 static void
@@ -605,20 +635,41 @@ soup_hsts_enforcer_has_valid_policy (SoupHSTSEnforcer *hsts_enforcer,
 				     const char *domain)
 {
 	char *canonicalized = NULL;
+	char *without_dot;
+	const char *original = domain;
 	gboolean retval;
 
 	g_return_val_if_fail (SOUP_IS_HSTS_ENFORCER (hsts_enforcer), FALSE);
 	g_return_val_if_fail (domain != NULL, FALSE);
 
+	/* Same normalisation as must_enforce_secure_transport, so the public API agrees with it. */
+	without_dot = domain_without_trailing_dots (domain);
+	if (without_dot)
+		domain = without_dot;
+
 	if (g_hostname_is_ascii_encoded (domain)) {
 		canonicalized = g_hostname_to_unicode (domain);
-		g_return_val_if_fail (canonicalized, FALSE);
+		if (!canonicalized) {
+			g_free (without_dot);
+			g_return_val_if_reached (FALSE);
+		}
 	}
 
 	retval = SOUP_HSTS_ENFORCER_GET_CLASS (hsts_enforcer)->has_valid_policy (hsts_enforcer,
 										 canonicalized ? canonicalized : domain);
 
+	/* A policy stored with the trailing dot by an older version (or set by the application under that name)
+	 * still applies to that spelling. */
+	if (!retval && without_dot) {
+		char *original_unicode = g_hostname_is_ascii_encoded (original) ? g_hostname_to_unicode (original) : NULL;
+
+		retval = SOUP_HSTS_ENFORCER_GET_CLASS (hsts_enforcer)->has_valid_policy (hsts_enforcer,
+											 original_unicode ? original_unicode : original);
+		g_free (original_unicode);
+	}
+
 	g_free (canonicalized);
+	g_free (without_dot);
 
 	return retval;
 }
diff --git a/libsoup/hsts/soup-hsts-policy.c b/libsoup/hsts/soup-hsts-policy.c
index 3e0c519..51f3590 100644
--- a/libsoup/hsts/soup-hsts-policy.c
+++ b/libsoup/hsts/soup-hsts-policy.c
@@ -291,7 +291,24 @@ soup_hsts_policy_new_from_response (SoupMessage *msg)
 		if (include_subdomains_value)
 			goto out;
 
-		policy = soup_hsts_policy_new (g_uri_get_host (uri), max_age, include_subdomains);
+		{
+			/* "example.com." is the same host as "example.com": a policy received for it is stored under
+			 * the name without trailing dots, which is what the enforcer looks up. An IP address written
+			 * with a trailing dot ("1.2.3.4.") is still an IP address and gets no policy. */
+			const char *host = g_uri_get_host (uri);
+			gsize len;
+			char *without_dots;
+
+			if (!host)
+				goto out;
+			len = strlen (host);
+			while (len > 1 && host[len - 1] == '.')
+				len--;
+			without_dots = g_strndup (host, len);
+			if (!g_hostname_is_ip_address (without_dots))
+				policy = soup_hsts_policy_new (without_dots, max_age, include_subdomains);
+			g_free (without_dots);
+		}
 	out:
 		soup_header_free_param_list (params);
 		return policy;
