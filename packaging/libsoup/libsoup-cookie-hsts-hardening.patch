diff --git a/tests/cookies-test.c b/tests/cookies-test.c
index c110fdc..7b14fba 100644
--- a/tests/cookies-test.c
+++ b/tests/cookies-test.c
@@ -604,6 +604,67 @@ do_get_cookies_empty_host_test (void)
 	g_uri_unref (uri);
 }
 
+static void
+do_cookies_ip_host_test (void)
+{
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *setter = g_uri_parse ("http://1.2.3.4/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *other = g_uri_parse ("http://7.7.3.4/", SOUP_HTTP_URI_FLAGS, NULL);
+	SoupCookie *cookie;
+	char *cookies;
+
+	/* RFC 6265 5.1.3: an IP address host only domain-matches itself. */
+	soup_cookie_jar_set_cookie (jar, setter, "suffix=1; Domain=3.4");
+	soup_cookie_jar_set_cookie (jar, setter, "exact=1");
+	cookies = soup_cookie_jar_get_cookies (jar, other, TRUE);
+	g_assert_null (cookies);
+	cookies = soup_cookie_jar_get_cookies (jar, setter, TRUE);
+	g_assert_cmpstr (cookies, ==, "exact=1");
+	g_free (cookies);
+
+	/* A cookie that is already in the jar (persistent storage, soup_cookie_jar_add_cookie())
+	 * must not be sent to another IP address either. */
+	soup_cookie_jar_add_cookie (jar, soup_cookie_new ("stored", "1", ".3.4", "/", -1));
+	cookies = soup_cookie_jar_get_cookies (jar, other, TRUE);
+	g_assert_null (cookies);
+
+	/* No domain at all never matches, for an IP address or a host name (no g_critical). */
+	cookie = soup_cookie_new ("x", "1", "1.2.3.4", "/", -1);
+	soup_cookie_set_domain (cookie, NULL);
+	g_assert_false (soup_cookie_domain_matches (cookie, "1.2.3.4"));
+	g_assert_false (soup_cookie_domain_matches (cookie, "example.com"));
+	soup_cookie_free (cookie);
+
+	/* Hosts that resolvers treat as IPv4 addresses (shorthand, octal, hex, trailing dot)
+	 * follow the same exact-match rule. */
+	cookie = soup_cookie_new ("y", "1", ".2.772", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "9.2.772"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".3.04", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "1.2.3.04"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".7.0x", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "9.7.0x"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".0x1", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "7.0x1"));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", ".3.4.", "/", -1);
+	g_assert_false (soup_cookie_domain_matches (cookie, "7.7.3.4."));
+	soup_cookie_free (cookie);
+	cookie = soup_cookie_new ("y", "1", "1.2.772", "/", -1);
+	g_assert_true (soup_cookie_domain_matches (cookie, "1.2.772"));
+	soup_cookie_free (cookie);
+	/* A host name is unchanged: suffix matching still applies. */
+	cookie = soup_cookie_new ("z", "1", ".example.com", "/", -1);
+	g_assert_true (soup_cookie_domain_matches (cookie, "www.example.com"));
+	soup_cookie_free (cookie);
+
+	g_uri_unref (setter);
+	g_uri_unref (other);
+	g_object_unref (jar);
+}
+
 static void
 send_callback (GObject *source_object,
 	       GAsyncResult *res,
@@ -1308,6 +1369,7 @@ main (int argc, char **argv)
 	g_test_add_func ("/cookies/parsing/control-characters", do_cookies_parsing_control_characters);
         g_test_add_func ("/cookies/parsing/name-value-max-size", do_cookies_parsing_name_value_max_size);
 	g_test_add_func ("/cookies/get-cookies/empty-host", do_get_cookies_empty_host_test);
+	g_test_add_func ("/cookies/ip-host", do_cookies_ip_host_test);
 	g_test_add_func ("/cookies/remove-feature", do_remove_feature_test);
 	g_test_add_func ("/cookies/secure-cookies", do_cookies_strict_secure_test);
 	g_test_add_func ("/cookies/prefix", do_cookies_prefix_test);
diff --git a/tests/hsts-db-test.c b/tests/hsts-db-test.c
index 9b1e580..a9a0ea6 100644
--- a/tests/hsts-db-test.c
+++ b/tests/hsts-db-test.c
@@ -4,6 +4,7 @@
 #include <glib/gstdio.h>
 
 #include <stdio.h>
+#include <sqlite3.h>
 #include "soup-uri-utils-private.h"
 
 #define DB_FILE "hsts-db.sqlite"
@@ -187,6 +188,34 @@ do_hsts_db_large_max_age_test (void)
 	g_remove (DB_FILE);
 }
 
+static void
+do_hsts_db_old_rows_test (void)
+{
+	SoupHSTSEnforcer *enforcer;
+	sqlite3 *db;
+	char *sql;
+	gint64 now = g_get_real_time () / G_USEC_PER_SEC;
+
+	/* A database written by an older version: a policy stored with a trailing dot keeps protecting that
+	 * spelling, and a damaged row with NULL values is skipped (it used to crash in strtoul). */
+	g_remove (DB_FILE);
+	g_assert_cmpint (sqlite3_open (DB_FILE, &db), ==, SQLITE_OK);
+	sql = g_strdup_printf ("CREATE TABLE soup_hsts_policies (id INTEGER PRIMARY KEY, host TEXT UNIQUE, max_age INTEGER, "
+			       "expiry INTEGER, include_subdomains INTEGER);"
+			       "INSERT INTO soup_hsts_policies VALUES (1, 'dotted.example.', 31536000, %" G_GINT64_FORMAT ", 0);"
+			       "INSERT INTO soup_hsts_policies VALUES (2, 'broken.example', NULL, NULL, NULL);",
+			       now + 31536000);
+	g_assert_cmpint (sqlite3_exec (db, sql, NULL, NULL, NULL), ==, SQLITE_OK);
+	g_free (sql);
+	sqlite3_close (db);
+
+	enforcer = soup_hsts_enforcer_db_new (DB_FILE);
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "dotted.example."));
+	g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "broken.example"));
+	g_object_unref (enforcer);
+	g_remove (DB_FILE);
+}
+
 int
 main (int argc, char **argv)
 {
@@ -209,6 +238,7 @@ main (int argc, char **argv)
 	g_test_add_func ("/hsts-db/basic", do_hsts_db_persistency_test);
 	g_test_add_func ("/hsts-db/subdomains", do_hsts_db_subdomains_test);
 	g_test_add_func ("/hsts-db/large-max-age", do_hsts_db_large_max_age_test);
+	g_test_add_func ("/hsts-db/old-rows", do_hsts_db_old_rows_test);
 
 	ret = g_test_run ();
 
diff --git a/tests/hsts-test.c b/tests/hsts-test.c
index dcc4629..9da2c99 100644
--- a/tests/hsts-test.c
+++ b/tests/hsts-test.c
@@ -336,6 +336,76 @@ do_hsts_superdomain_test (void)
