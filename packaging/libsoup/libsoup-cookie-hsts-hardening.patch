+static void
+do_cookies_same_site_no_host_test (void)
+{
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *a = g_uri_parse ("https://a.example/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *top = g_uri_parse ("https://b.example/", SOUP_HTTP_URI_FLAGS, NULL);
+	const char *sites[] = { "https://a.example/", "https://b.example/", "about:blank", "data:text/plain,x", NULL };
+	guint expected[] = { 2, 0, 0, 0 };
+	int i;
+
+	soup_cookie_jar_set_cookie (jar, a, "s=1; SameSite=Strict");
+	soup_cookie_jar_set_cookie (jar, a, "l=1; SameSite=Lax");
+
+	/* A request from another site (top level b.example) gets no SameSite cookie, and neither does one whose
+	 * site_for_cookies has no host at all; the first row is the control: the own site gets both. */
+	for (i = 0; sites[i]; i++) {
+		GUri *site = g_uri_parse (sites[i], SOUP_HTTP_URI_FLAGS, NULL);
+		GSList *list = soup_cookie_jar_get_cookie_list_with_same_site_info (jar, a, top, site, TRUE, TRUE, FALSE);
+
+		g_test_message ("site_for_cookies %s", sites[i]);
+		g_assert_cmpuint (g_slist_length (list), ==, expected[i]);
+		g_slist_free_full (list, (GDestroyNotify) soup_cookie_free);
+		g_uri_unref (site);
+	}
+
+	g_uri_unref (a);
+	g_uri_unref (top);
+	g_object_unref (jar);
+}
