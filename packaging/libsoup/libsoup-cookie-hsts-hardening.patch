+/* "example.org." and "example.org" are the same host: a policy that an older version stored for https://example.org./
+ * lives under the name with the dot, a newer one stores it without. max-age=0 ends the policy of the host, whichever
+ * way it was written down. */
+static void
+remove_host_policy_any_spelling (SoupHSTSEnforcer *hsts_enforcer, const char *domain)
+{
+	gsize len = strlen (domain);
+	char *base, *dotted;
+
+	while (len > 1 && domain[len - 1] == '.')
+		len--;
+	base = g_strndup (domain, len);
+	dotted = g_strconcat (base, ".", NULL);
+
+	soup_hsts_enforcer_remove_host_policy (hsts_enforcer, domain);
+	if (strcmp (base, domain) != 0)
+		soup_hsts_enforcer_remove_host_policy (hsts_enforcer, base);
+	if (strcmp (dotted, domain) != 0)
+		soup_hsts_enforcer_remove_host_policy (hsts_enforcer, dotted);
+
+	g_free (base);
+	g_free (dotted);
+}
