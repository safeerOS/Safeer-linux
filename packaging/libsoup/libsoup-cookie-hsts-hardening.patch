+/* Obnovitev istega pravila (to naredi vsak HTTPS odgovor z glavo STS) ne sme biti odvisna od stranskega ucinka v g_assert. */
+static void
+do_hsts_renew_policy_test (void)
+{
+        SoupHSTSEnforcer *enforcer = soup_hsts_enforcer_new ();
+        SoupHSTSPolicy *policy;
+        int i;
+
+        for (i = 0; i < 3; i++) {
+                policy = soup_hsts_policy_new ("example.com", 3600 + i, FALSE);
+                soup_hsts_enforcer_set_policy (enforcer, policy);
+                soup_hsts_policy_free (policy);
+                g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "example.com"));
+        }
+
+        g_object_unref (enforcer);
+}
