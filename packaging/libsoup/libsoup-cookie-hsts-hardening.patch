 static void
+do_cookie_cross_origin_redirect_test (void)
+{
+	SoupSession *session = soup_test_session_new (NULL);
+	GUri *uri = g_uri_parse_relative (base_uri, "/cookie-to-server2", SOUP_HTTP_URI_FLAGS, NULL);
+	SoupMessage *msg = soup_message_new_from_uri ("GET", uri);
+	GBytes *body;
+
+	/* A Cookie header set by the application is a credential like Authorization: it must
+	 * not follow a redirect to another origin. */
+	soup_message_headers_replace (soup_message_get_request_headers (msg), "Cookie", "session=secret");
+	soup_message_headers_replace (soup_message_get_request_headers (msg), "Authorization", "Bearer secret");
+	body = soup_test_session_async_send (session, msg, NULL, NULL);
+	soup_test_assert_message_status (msg, SOUP_STATUS_OK);
+	G_LOCK (server2_cookie);
+	g_assert_cmpstr (server2_cookie, ==, "(none)|(none)");
+	g_clear_pointer (&server2_cookie, g_free);
+	G_UNLOCK (server2_cookie);
+
+	g_bytes_unref (body);
+	g_object_unref (msg);
+	g_uri_unref (uri);
+	soup_test_session_abort_unref (session);
+}
+
+static void
+do_cookie_same_origin_redirect_test (void)
+{
+	SoupSession *session = soup_test_session_new (NULL);
