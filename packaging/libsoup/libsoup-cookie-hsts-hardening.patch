+}
+
+static void
+do_hsts_invalid_punycode_test (void)
+{
+        static const struct {
+                const char *uri;
+                gboolean enforced;
+        } cases[] = {
+                { "http://www.example.com/", TRUE },
+                { "http://xn--ls8h.example.com/", TRUE },
+                { "http://xn--9999999999.example.com/", TRUE },
+                { "http://xn--999999999999999a.example.com/", TRUE },
+        };
+        SoupHSTSEnforcer *enforcer = soup_hsts_enforcer_new ();
+        SoupSession *session = hsts_session_new (enforcer);
+        guint i;
+
+        soup_hsts_enforcer_set_session_policy (enforcer, "example.com", TRUE);
+
+        for (i = 0; i < G_N_ELEMENTS (cases); i++) {
+                SoupMessage *msg = soup_message_new ("GET", cases[i].uri);
+                GCancellable *cancellable = g_cancellable_new ();
+                gboolean enforced = FALSE;
+                gboolean starting = FALSE;
+                GError *error = NULL;
+                GBytes *body;
+
+                soup_message_add_flags (msg, SOUP_MESSAGE_NO_REDIRECT);
+                g_signal_connect (msg, "hsts-enforced", G_CALLBACK (message_starting_cb), &enforced);
+                g_signal_connect (msg, "hsts-enforced", G_CALLBACK (cancel_on_hsts_enforced_cb), cancellable);
+                g_signal_connect (msg, "starting", G_CALLBACK (message_starting_cb), &starting);
+
+                body = soup_session_send_and_read (session, msg, cancellable, &error);
+                g_assert_cmpint (enforced, ==, cases[i].enforced);
+                g_assert_false (starting);
+                g_assert_null (body);
+                g_clear_error (&error);
+
+                g_object_unref (msg);
+                g_object_unref (cancellable);
+        }
+
+        soup_test_session_abort_unref (session);
+        g_object_unref (enforcer);
+}
