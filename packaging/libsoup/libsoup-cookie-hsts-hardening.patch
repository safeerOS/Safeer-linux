+static void
+do_cookies_public_suffix_case_api_test (void)
+{
+	const char *suffixes[] = { ".CO.UK", ".CO.UK.", ".Co.Uk", "CO.UK", ".GITHUB.IO", NULL };
+	SoupCookieJar *jar;
+	SoupSession *session;
+	int i;
+
+	/* soup_cookie_jar_add_cookie() has no origin to check: the public suffix check is all there is. */
+	for (i = 0; suffixes[i]; i++) {
+		const char *victim = g_str_has_suffix (suffixes[i], "IO") ? "victim.github.io" : "victim.co.uk";
+
+		session = proxied_session (SOUP_COOKIE_JAR_ACCEPT_ALWAYS, &jar);
+		soup_cookie_jar_add_cookie (jar, soup_cookie_new ("x", "1", suffixes[i], "/", -1));
+		g_assert_cmpuint (jar_cookie_count (jar), ==, 0);
+		proxied_get (session, victim, NULL, NULL);
+		assert_server_saw_cookie (victim, "(none)");
+		soup_test_session_abort_unref (session);
+	}
+
+	/* The control: a cookie for a registrable domain is stored and sent, whatever its case. */
+	session = proxied_session (SOUP_COOKIE_JAR_ACCEPT_ALWAYS, &jar);
+	soup_cookie_jar_add_cookie (jar, soup_cookie_new ("x", "1", ".EXAMPLE.COM", "/", -1));
+	g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+	proxied_get (session, "www.example.com", NULL, NULL);
+	assert_server_saw_cookie ("www.example.com", "x=1");
+	soup_test_session_abort_unref (session);
+}
