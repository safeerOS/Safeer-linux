+	SoupMessage *msg = soup_message_new_from_uri ("GET", uri);
+	GBytes *body;
+
+	/* The control for the test above: a redirect to the same origin keeps the headers, so the
+	 * check there does prove that the server saw the request and that the cross-origin
+	 * redirect is what removed them. */
+	soup_message_headers_replace (soup_message_get_request_headers (msg), "Cookie", "session=secret");
+	soup_message_headers_replace (soup_message_get_request_headers (msg), "Authorization", "Bearer secret");
+	body = soup_test_session_async_send (session, msg, NULL, NULL);
+	soup_test_assert_message_status (msg, SOUP_STATUS_OK);
+	G_LOCK (server_cookie);
+	g_assert_cmpstr (server_cookie, ==, "session=secret|Bearer secret");
+	g_clear_pointer (&server_cookie, g_free);
+	G_UNLOCK (server_cookie);
+
+	g_bytes_unref (body);
+	g_object_unref (msg);
+	g_uri_unref (uri);
+	soup_test_session_abort_unref (session);
+}
