+static void
+do_cookies_public_suffix_case_host_test (void)
+{
+	/* The host of the URI is not lower-cased by GUri: an application may pass it in any case. */
+	SoupCookieJar *jar = soup_cookie_jar_new ();
+	GUri *evil = g_uri_parse ("http://EVIL.CO.UK/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *tracker = g_uri_parse ("http://TRACKER.EVIL.CO.UK/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *site = g_uri_parse ("http://SITE.CO.UK/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *www = g_uri_parse ("http://WWW.EXAMPLE.COM/", SOUP_HTTP_URI_FLAGS, NULL);
+	GUri *victim = g_uri_parse ("http://VICTIM.CO.UK/", SOUP_HTTP_URI_FLAGS, NULL);
+	char *cookies;
+
+	/* The control comes first: this jar stores a cookie set from an upper case host. */
+	soup_cookie_jar_set_cookie (jar, www, "k=v; Domain=EXAMPLE.COM");
+	g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=CO.UK");
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=co.uk");
+	soup_cookie_jar_set_cookie (jar, evil, "x=1; Domain=.CO.UK.");
+	g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+	cookies = soup_cookie_jar_get_cookies (jar, victim, TRUE);
+	g_assert_null (cookies);
+
+	soup_cookie_jar_set_accept_policy (jar, SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY);
+	soup_cookie_jar_set_cookie_with_first_party (jar, tracker, site, "x=1; Domain=CO.UK");
+	g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+	cookies = soup_cookie_jar_get_cookies (jar, victim, TRUE);
+	g_assert_null (cookies);
+	cookies = soup_cookie_jar_get_cookies (jar, site, TRUE);
+	g_assert_null (cookies);
+
+	g_uri_unref (evil);
+	g_uri_unref (tracker);
+	g_uri_unref (site);
+	g_uri_unref (www);
+	g_uri_unref (victim);
+	g_object_unref (jar);
+}
