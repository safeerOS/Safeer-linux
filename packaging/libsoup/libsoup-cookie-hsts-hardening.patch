+static const PublicSuffixCaseTest public_suffix_accepted_tests[] = {
+	/* The controls: the same sessions do store and send cookies that are allowed, in any case. */
+	{ "www.example.com", "k=v; Domain=EXAMPLE.COM", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "other.example.com" },
+	{ "www.example.com", "k=v; Domain=example.com", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "other.example.com" },
+	{ "www.example.com.", "k=v; Domain=.Example.Com.", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "other.example.com." },
+	{ "tracker.example.com", "k=v; Domain=EXAMPLE.COM", "http://www.example.com/", SOUP_COOKIE_JAR_ACCEPT_NO_THIRD_PARTY, "www.example.com" },
+	{ "evil.co.uk", "k=v", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "evil.co.uk" },
+	{ "evil.co.uk", "k=v; Domain=EVIL.CO.UK", NULL, SOUP_COOKIE_JAR_ACCEPT_ALWAYS, "www.evil.co.uk" },
+};
+
+static void
+do_cookies_public_suffix_case_test (void)
+{
+	guint i;
+
+	for (i = 0; i < G_N_ELEMENTS (public_suffix_accepted_tests); i++) {
+		const PublicSuffixCaseTest *test = &public_suffix_accepted_tests[i];
+		SoupCookieJar *jar;
+		SoupSession *session = proxied_session (test->policy, &jar);
+
+		g_test_message ("accepted %u: %s %s", i, test->setter, test->set_cookie);
+		proxied_get (session, test->setter, test->set_cookie, test->first_party);
+		g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+		proxied_get (session, test->victim, NULL, test->first_party);
+		assert_server_saw_cookie (test->victim, "k=v");
+		soup_test_session_abort_unref (session);
+	}
+
+	for (i = 0; i < G_N_ELEMENTS (public_suffix_rejected_tests); i++) {
+		const PublicSuffixCaseTest *test = &public_suffix_rejected_tests[i];
+		SoupCookieJar *jar;
+		SoupSession *session = proxied_session (test->policy, &jar);
+
+		g_test_message ("rejected %u: %s %s", i, test->setter, test->set_cookie);
+		proxied_get (session, test->setter, test->set_cookie, test->first_party);
+		g_assert_cmpuint (jar_cookie_count (jar), ==, 0);
+		proxied_get (session, test->victim, NULL, test->first_party);
+		assert_server_saw_cookie (test->victim, "(none)");
+		soup_test_session_abort_unref (session);
+	}
+}
