+static void
+hsts_enforced_only (SoupSession *session, const char *uri, gboolean expected_enforced)
+{
+	SoupMessage *msg = soup_message_new ("GET", uri);
+	gboolean enforced = FALSE;
+	GBytes *body;
+
+	g_signal_connect (msg, "hsts-enforced", G_CALLBACK (hsts_enforced_cb), &enforced);
+	soup_message_add_flags (msg, SOUP_MESSAGE_NO_REDIRECT);
+	/* Only the upgrade decision matters here; the TLS name check of "localhost." may fail. */
+	body = soup_session_send_and_read (session, msg, NULL, NULL);
+	g_assert_true (enforced == expected_enforced);
+	g_clear_pointer (&body, g_bytes_unref);
+	g_object_unref (msg);
+}
+
+static void
+do_hsts_trailing_dot_test (void)
+{
+	SoupHSTSEnforcer *enforcer = soup_hsts_enforcer_new ();
+	SoupSession *session = hsts_session_new (enforcer);
+	SoupHSTSPolicy *policy;
+	SoupMessage *msg;
+
+	/* "localhost." names the same host as "localhost". */
+	session_get_uri (session, "https://localhost/long-lasting", SOUP_STATUS_OK, FALSE);
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "localhost."));
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "localhost.."));
+	hsts_enforced_only (session, "http://localhost./", TRUE);
+	hsts_enforced_only (session, "http://localhost../", TRUE);
+	soup_test_session_abort_unref (session);
+	g_object_unref (enforcer);
+
+	/* A policy created with a trailing dot (application, session policy, database of an older
+	 * version) keeps its name and still applies to that spelling. */
+	policy = soup_hsts_policy_new_full ("example.org.", 3600, NULL, FALSE);
+	g_assert_cmpstr (soup_hsts_policy_get_domain (policy), ==, "example.org.");
+	soup_hsts_policy_free (policy);
+	enforcer = soup_hsts_enforcer_new ();
+	soup_hsts_enforcer_set_session_policy (enforcer, "example.net.", FALSE);
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "example.net."));
+	g_object_unref (enforcer);
+
+	/* A parent stored with a trailing dot and includeSubDomains still covers its subdomains written
+	 * with a trailing dot (as before this change). */
+	enforcer = soup_hsts_enforcer_new ();
+	session = hsts_session_new (enforcer);
+	soup_hsts_enforcer_set_session_policy (enforcer, "localhost.", TRUE);
+	hsts_enforced_only (session, "http://sub.localhost./", TRUE);
+	soup_test_session_abort_unref (session);
+	g_object_unref (enforcer);
+
+	/* An IP address with a trailing dot gets no policy (and no g_critical). */
+	msg = soup_message_new ("GET", "https://1.2.3.4./");
+	soup_message_headers_append (soup_message_get_response_headers (msg),
+				     "Strict-Transport-Security", "max-age=31536000");
+	g_assert_null (soup_hsts_policy_new_from_response (msg));
+	g_object_unref (msg);
+
+	/* A policy received for "example.com." is stored under "example.com", not dropped. */
+	msg = soup_message_new ("GET", "https://example.com./");
+	soup_message_headers_append (soup_message_get_response_headers (msg),
+				     "Strict-Transport-Security", "max-age=31536000");
+	policy = soup_hsts_policy_new_from_response (msg);
+	g_assert_nonnull (policy);
+	g_assert_cmpstr (soup_hsts_policy_get_domain (policy), ==, "example.com");
+	soup_hsts_policy_free (policy);
+	g_object_unref (msg);
+}
+
