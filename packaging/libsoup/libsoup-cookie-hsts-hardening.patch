+static void
+do_cookies_public_suffix_single_label_test (void)
+{
+	GUri *origin = g_uri_parse ("http://evil.internal./", SOUP_HTTP_URI_FLAGS, NULL);
+	SoupCookie *cookie;
+
+	/* The parser alone: a domain of one label is no domain, with or without dots around it. */
+	g_assert_null (soup_cookie_parse ("x=1; Domain=internal.", origin));
