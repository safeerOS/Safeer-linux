+	policy = soup_hsts_policy_new ("legacy.example.", 3600, FALSE);
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	policy = soup_hsts_policy_new ("both.example.", 3600, FALSE);
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	policy = soup_hsts_policy_new ("both.example", 3600, FALSE);
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	policy = soup_hsts_policy_new ("other.example.", 3600, FALSE);
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "legacy.example."));
+	g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "both.example"));
+
+	/* max-age=0 received for https://legacy.example./ ends the policy of that host, however it was written down. */
+	msg = soup_message_new ("GET", "https://legacy.example./");
+	soup_message_headers_append (soup_message_get_response_headers (msg), "Strict-Transport-Security", "max-age=0");
+	policy = soup_hsts_policy_new_from_response (msg);
+	g_assert_nonnull (policy);
+	g_assert_cmpstr (soup_hsts_policy_get_domain (policy), ==, "legacy.example");
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	g_object_unref (msg);
+	g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "legacy.example."));
+	g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "legacy.example"));
+
+	/* The same for the host that has both. */
+	msg = soup_message_new ("GET", "https://both.example/");
+	soup_message_headers_append (soup_message_get_response_headers (msg), "Strict-Transport-Security", "max-age=0");
+	policy = soup_hsts_policy_new_from_response (msg);
+	g_assert_nonnull (policy);
+	soup_hsts_enforcer_set_policy (enforcer, policy);
+	soup_hsts_policy_free (policy);
+	g_object_unref (msg);
+	g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "both.example."));
+	g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "both.example"));
