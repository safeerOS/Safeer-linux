+/* The rows of the public suffix tests that follow: the cookie must not be stored and the victim must not get it
+ * ("rejected"), or it must be stored and sent ("accepted", the controls that prove the same session works). */
+static void
+check_public_suffix_rows (const PublicSuffixCaseTest *rejected, guint n_rejected,
+						  const PublicSuffixCaseTest *accepted, guint n_accepted)
+{
+	guint i;
+
+	for (i = 0; i < n_accepted; i++) {
+		const PublicSuffixCaseTest *test = &accepted[i];
+		SoupCookieJar *jar;
+		SoupSession *session = proxied_session (test->policy, &jar);
+
+		g_test_message ("accepted %u: %s %s", i, test->setter, test->set_cookie);
+		proxied_get (session, test->setter, test->set_cookie, test->first_party);
+		g_assert_cmpuint (jar_cookie_count (jar), ==, 1);
+		proxied_get (session, test->victim, NULL, test->first_party);
+		assert_server_saw_cookie (test->victim, "k=v");
+		soup_test_session_abort_unref (session);
+	}
+
+	for (i = 0; i < n_rejected; i++) {
+		const PublicSuffixCaseTest *test = &rejected[i];
+		SoupCookieJar *jar;
+		SoupSession *session = proxied_session (test->policy, &jar);
+
+		g_test_message ("rejected %u: %s %s", i, test->setter, test->set_cookie);
+		proxied_get (session, test->setter, test->set_cookie, test->first_party);
+		g_assert_cmpuint (jar_cookie_count (jar), ==, 0);
+		proxied_get (session, test->victim, NULL, test->first_party);
+		assert_server_saw_cookie (test->victim, "(none)");
+		soup_test_session_abort_unref (session);
+	}
+}
