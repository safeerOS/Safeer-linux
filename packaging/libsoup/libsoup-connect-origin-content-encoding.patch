diff --git a/tests/proxy-connect-test.c b/tests/proxy-connect-test.c
new file mode 100644
index 0000000..c8b0398
--- /dev/null
+++ b/tests/proxy-connect-test.c
@@ -0,0 +1,262 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 8 -*- */
+/*
+ * The response to a CONNECT request is generated by the HTTP proxy (or by
+ * anyone on the plain-text path to an http:// proxy), not by the origin
+ * server, even though the CONNECT message carries the origin's https:// URI.
+ * Nothing in that response may change state that belongs to the origin.
+ */
+
+#include "test-utils.h"
+
+/* The fake proxy runs in its own thread with blocking I/O: the synchronous
+ * session below does not iterate the default main context, so a
+ * GSocketService would never accept the connection. */
+typedef struct {
+        GSocketListener *listener;
+        GCancellable *cancellable;
+        const char *response;
+        gint connects;
+        GThread *thread;
+        char *uri;
+} FakeProxy;
+
+static gpointer
+fake_proxy_thread (gpointer user_data)
+{
+        FakeProxy *proxy = user_data;
+        GSocketConnection *connection;
+
+        while ((connection = g_socket_listener_accept (proxy->listener, NULL,
+                                                       proxy->cancellable, NULL))) {
+                GInputStream *in = g_io_stream_get_input_stream (G_IO_STREAM (connection));
+                GOutputStream *out = g_io_stream_get_output_stream (G_IO_STREAM (connection));
+                GString *request = g_string_new (NULL);
+                char buf[1024];
+                gssize n;
+
+                while (!strstr (request->str, "\r\n\r\n") &&
+                       (n = g_input_stream_read (in, buf, sizeof (buf), NULL, NULL)) > 0)
+                        g_string_append_len (request, buf, n);
+                if (g_str_has_prefix (request->str, "CONNECT "))
+                        g_atomic_int_inc (&proxy->connects);
+                g_output_stream_write_all (out, proxy->response, strlen (proxy->response),
+                                           NULL, NULL, NULL);
+                g_io_stream_close (G_IO_STREAM (connection), NULL, NULL);
+                g_string_free (request, TRUE);
+                g_object_unref (connection);
+        }
+
+        return NULL;
+}
+
+static void
+fake_proxy_start (FakeProxy *proxy, const char *response)
+{
+        GError *error = NULL;
+        guint16 port;
+
+        proxy->response = response;
+        proxy->connects = 0;
+        proxy->listener = g_socket_listener_new ();
+        proxy->cancellable = g_cancellable_new ();
+        port = g_socket_listener_add_any_inet_port (proxy->listener, NULL, &error);
+        g_assert_no_error (error);
+        proxy->uri = g_strdup_printf ("http://127.0.0.1:%u", port);
+        proxy->thread = g_thread_new ("fake-proxy", fake_proxy_thread, proxy);
+}
+
+static void
+fake_proxy_stop (FakeProxy *proxy)
+{
+        g_cancellable_cancel (proxy->cancellable);
+        g_thread_join (proxy->thread);
+        g_socket_listener_close (proxy->listener);
+        g_object_unref (proxy->listener);
+        g_object_unref (proxy->cancellable);
+        g_free (proxy->uri);
+}
+
+static SoupSession *
+session_for_proxy (FakeProxy *proxy)
+{
+        GProxyResolver *resolver = g_simple_proxy_resolver_new (proxy->uri, NULL);
+        SoupSession *session = soup_test_session_new ("proxy-resolver", resolver, NULL);
+
+        g_object_unref (resolver);
+        return session;
+}
+
+/* Sends one request through the proxy. The tunnel is never usable: the proxy
+ * either refuses it (the message gets the proxy's status) or closes it. */
+static void
+send_through_proxy (SoupSession *session, FakeProxy *proxy, SoupMessage *msg)
+{
+        GBytes *body;
+        GError *error = NULL;
+
+        body = soup_session_send_and_read (session, msg, NULL, &error);
+        g_clear_error (&error);
+        g_clear_pointer (&body, g_bytes_unref);
+        /* The proxy really answered the CONNECT (otherwise the test proves nothing). */
+        g_assert_cmpint (g_atomic_int_get (&proxy->connects), >=, 1);
+}
+
+static const char *cookie_responses[] = {
+        "HTTP/1.1 200 Connection established\r\n"
+        "Set-Cookie: injected=1; Secure; Path=/\r\n"
+        "\r\n",
+        "HTTP/1.1 407 Proxy Authentication Required\r\n"
+        "Proxy-Authenticate: Basic realm=\"proxy\"\r\n"
+        "Set-Cookie: injected=1; Secure; Path=/\r\n"
+        "Content-Length: 0\r\n"
+        "\r\n",
+        "HTTP/1.1 403 Forbidden\r\n"
+        "Set-Cookie: injected=1; Path=/\r\n"
+        "Content-Length: 0\r\n"
+        "\r\n",
+};
+
+static void
+do_connect_cookies_test (gconstpointer data)
+{
+        FakeProxy proxy;
+        SoupSession *session;
+        SoupCookieJar *jar;
+        SoupMessage *msg;
+        GSList *cookies;
+
+        fake_proxy_start (&proxy, data);
+        session = session_for_proxy (&proxy);
+        jar = soup_cookie_jar_new ();
+        soup_session_add_feature (session, SOUP_SESSION_FEATURE (jar));
+
+        msg = soup_message_new ("GET", "https://example.com/");
+        send_through_proxy (session, &proxy, msg);
+
+        cookies = soup_cookie_jar_all_cookies (jar);
+        g_assert_cmpuint (g_slist_length (cookies), ==, 0);
+        g_slist_free_full (cookies, (GDestroyNotify)soup_cookie_free);
+
+        g_object_unref (msg);
+        g_object_unref (jar);
+        soup_test_session_abort_unref (session);
+        fake_proxy_stop (&proxy);
+}
+
+static void
+do_connect_hsts_remove_test (void)
+{
+        FakeProxy proxy;
+        SoupSession *session;
+        SoupHSTSEnforcer *enforcer;
+        SoupHSTSPolicy *policy;
+        SoupMessage *msg;
+
+        fake_proxy_start (&proxy,
+                          "HTTP/1.1 403 Forbidden\r\n"
+                          "Strict-Transport-Security: max-age=0\r\n"
+                          "Content-Length: 0\r\n"
+                          "\r\n");
+        session = session_for_proxy (&proxy);
+        enforcer = soup_hsts_enforcer_new ();
+        soup_session_add_feature (session, SOUP_SESSION_FEATURE (enforcer));
+        policy = soup_hsts_policy_new ("example.com", 31536000, FALSE);
+        soup_hsts_enforcer_set_policy (enforcer, policy);
+        soup_hsts_policy_free (policy);
+
+        msg = soup_message_new ("GET", "https://example.com/");
+        send_through_proxy (session, &proxy, msg);
+
+        /* Otherwise the next http:// request would go out in plain text. */
+        g_assert_true (soup_hsts_enforcer_has_valid_policy (enforcer, "example.com"));
+
+        g_object_unref (msg);
+        g_object_unref (enforcer);
+        soup_test_session_abort_unref (session);
+        fake_proxy_stop (&proxy);
+}
+
+static void
+do_connect_hsts_add_test (void)
+{
+        FakeProxy proxy;
+        SoupSession *session;
+        SoupHSTSEnforcer *enforcer;
+        SoupMessage *msg;
+
+        fake_proxy_start (&proxy,
+                          "HTTP/1.1 403 Forbidden\r\n"
+                          "Strict-Transport-Security: max-age=31536000; includeSubDomains\r\n"
+                          "Content-Length: 0\r\n"
+                          "\r\n");
+        session = session_for_proxy (&proxy);
+        enforcer = soup_hsts_enforcer_new ();
+        soup_session_add_feature (session, SOUP_SESSION_FEATURE (enforcer));
+
+        msg = soup_message_new ("GET", "https://example.com/");
+        send_through_proxy (session, &proxy, msg);
+
+        g_assert_false (soup_hsts_enforcer_has_valid_policy (enforcer, "example.com"));
+
+        g_object_unref (msg);
+        g_object_unref (enforcer);
+        soup_test_session_abort_unref (session);
+        fake_proxy_stop (&proxy);
+}
+
+static gboolean
+authenticate_cb (SoupMessage *msg, SoupAuth *auth, gboolean retrying, gpointer user_data)
+{
+        guint *count = user_data;
+
+        (*count)++;
+        return FALSE;
+}
+
+static void
+do_connect_auth_test (void)
+{
+        FakeProxy proxy;
+        SoupSession *session;
+        SoupMessage *msg;
+        guint authenticate_count = 0;
+
+        fake_proxy_start (&proxy,
+                          "HTTP/1.1 401 Unauthorized\r\n"
+                          "WWW-Authenticate: Basic realm=\"chosen by the proxy\"\r\n"
+                          "Content-Length: 0\r\n"
+                          "\r\n");
+        session = session_for_proxy (&proxy);
+
+        msg = soup_message_new ("GET", "https://example.com/");
+        g_signal_connect (msg, "authenticate", G_CALLBACK (authenticate_cb), &authenticate_count);
+        send_through_proxy (session, &proxy, msg);
+
+        /* A 401 from the proxy must not ask the application for the origin's
+         * credentials (the realm and the prompt are the proxy's). */
+        g_assert_cmpuint (authenticate_count, ==, 0);
+
+        g_object_unref (msg);
+        soup_test_session_abort_unref (session);
+        fake_proxy_stop (&proxy);
+}
+
+int
+main (int argc, char **argv)
+{
+        int ret;
+
+        test_init (argc, argv, NULL);
+
+        g_test_add_data_func ("/proxy-connect/cookies/200", cookie_responses[0], do_connect_cookies_test);
+        g_test_add_data_func ("/proxy-connect/cookies/407", cookie_responses[1], do_connect_cookies_test);
+        g_test_add_data_func ("/proxy-connect/cookies/403", cookie_responses[2], do_connect_cookies_test);
+        g_test_add_func ("/proxy-connect/hsts/remove", do_connect_hsts_remove_test);
+        g_test_add_func ("/proxy-connect/hsts/add", do_connect_hsts_add_test);
+        g_test_add_func ("/proxy-connect/auth/401", do_connect_auth_test);
+
+        ret = g_test_run ();
+
+        test_cleanup ();
+        return ret;
+}
