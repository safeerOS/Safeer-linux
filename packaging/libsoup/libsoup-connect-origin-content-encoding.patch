diff --git a/tests/content-encoding-limit-test.c b/tests/content-encoding-limit-test.c
new file mode 100644
index 0000000..bc1e1f4
--- /dev/null
+++ b/tests/content-encoding-limit-test.c
@@ -0,0 +1,186 @@
+/* -*- Mode: C; tab-width: 8; indent-tabs-mode: nil; c-basic-offset: 8 -*- */
+/*
+ * A server (or a man-in-the-middle on http://) chooses the Content-Encoding
+ * header. Every coding becomes one nested decoder stream, so a header with
+ * thousands of codings must not make the client recurse through thousands
+ * of streams when it reads the body.
+ */
+
+#include "test-utils.h"
+
+#ifdef G_OS_UNIX
+#include <pthread.h>
+#endif
+
+static GUri *base_uri;
+static GBytes *nested_body;
+
+/* gzip-compresses data once (each coding in the header really applied, so
+ * every decoder in the chain has valid input and is actually entered). */
+static GBytes *
+gzip_once (GBytes *data)
+{
+        GZlibCompressor *compressor = g_zlib_compressor_new (G_ZLIB_COMPRESSOR_FORMAT_GZIP, 1);
+        GOutputStream *mem = g_memory_output_stream_new_resizable ();
+        GOutputStream *out = g_converter_output_stream_new (mem, G_CONVERTER (compressor));
+        gsize len;
+        const char *p = g_bytes_get_data (data, &len);
+        GBytes *result;
+
+        g_assert_true (g_output_stream_write_all (out, p, len, NULL, NULL, NULL));
+        g_assert_true (g_output_stream_close (out, NULL, NULL));
+        result = g_memory_output_stream_steal_as_bytes (G_MEMORY_OUTPUT_STREAM (mem));
+        g_object_unref (out);
+        g_object_unref (mem);
+        g_object_unref (compressor);
+        return result;
+}
+
+static void
+server_callback (SoupServer        *server,
+                 SoupServerMessage *msg,
+                 const char        *path,
+                 GHashTable        *query,
+                 gpointer           data)
+{
+        guint n = GPOINTER_TO_UINT (data);
+        SoupMessageHeaders *headers = soup_server_message_get_response_headers (msg);
+        GString *codings = g_string_new (NULL);
+        guint i;
+
+        /* "gzip" twice is still a sensible response; many is not. */
+        for (i = 0; i < n; i++)
+                g_string_append (codings, i ? ",gzip" : "gzip");
+        soup_message_headers_replace (headers, "Content-Encoding", codings->str);
+        g_string_free (codings, TRUE);
+
+        soup_server_message_set_status (msg, SOUP_STATUS_OK, NULL);
+        soup_server_message_set_response (msg, "text/plain", SOUP_MEMORY_COPY,
+                                          g_bytes_get_data (nested_body, NULL), g_bytes_get_size (nested_body));
+}
+
+static gpointer
+send_in_thread (gpointer data)
+{
+        SoupMessage *msg = data;
+        SoupSession *session = soup_test_session_new (NULL);
+        GBytes *body;
+        GError *error = NULL;
+
+        /* Must return (decoded or not) instead of overflowing the stack. */
+        body = soup_session_send_and_read (session, msg, NULL, &error);
+        g_clear_error (&error);
+        g_clear_pointer (&body, g_bytes_unref);
+        soup_test_session_abort_unref (session);
+        return NULL;
+}
+
+static void
+do_many_codings_test (gconstpointer data)
+{
+        SoupServer *server;
+        SoupMessage *msg;
+
+        guint i;
+
+        nested_body = g_bytes_new_static ("plain body", 10);
+        for (i = 0; i < GPOINTER_TO_UINT (data); i++) {
+                GBytes *next = gzip_once (nested_body);
+                g_bytes_unref (nested_body);
+                nested_body = next;
+        }
+
+        server = soup_test_server_new (SOUP_TEST_SERVER_IN_THREAD);
+        soup_server_add_handler (server, NULL, server_callback, (gpointer)data, NULL);
+        base_uri = soup_test_server_get_uri (server, "http", NULL);
+
+        msg = soup_message_new_from_uri ("GET", base_uri);
+#ifdef G_OS_UNIX
+        {
+                /* Applications often run a session in a worker thread with a
+                 * smaller stack than the main thread (1 MiB here). */
+                pthread_attr_t attr;
+                pthread_t thread;
+
+                pthread_attr_init (&attr);
+                g_assert_cmpint (pthread_attr_setstacksize (&attr, 1024 * 1024), ==, 0);
+                g_assert_cmpint (pthread_create (&thread, &attr, send_in_thread, msg), ==, 0);
+                pthread_join (thread, NULL);
+                pthread_attr_destroy (&attr);
+        }
+#else
+        send_in_thread (msg);
+#endif
+        soup_test_assert_message_status (msg, SOUP_STATUS_OK);
+
+        g_object_unref (msg);
+        g_uri_unref (base_uri);
+        soup_test_server_quit_unref (server);
+        g_bytes_unref (nested_body);
+}
+
+static void
+do_boundary_test (gconstpointer data)
+{
+        guint n = GPOINTER_TO_UINT (data), i;
+        SoupServer *server;
+        SoupSession *session;
+        SoupMessage *msg;
+        GBytes *body;
+        GError *error = NULL;
+        gsize len;
+        const guchar *p;
+
+        nested_body = g_bytes_new_static ("plain body", 10);
+        for (i = 0; i < n; i++) {
+                GBytes *next = gzip_once (nested_body);
+                g_bytes_unref (nested_body);
+                nested_body = next;
+        }
+
+        server = soup_test_server_new (SOUP_TEST_SERVER_IN_THREAD);
+        soup_server_add_handler (server, NULL, server_callback, (gpointer)data, NULL);
+        base_uri = soup_test_server_get_uri (server, "http", NULL);
+        session = soup_test_session_new (NULL);
+        msg = soup_message_new_from_uri ("GET", base_uri);
+        body = soup_session_send_and_read (session, msg, NULL, &error);
+        g_assert_no_error (error);
+        soup_test_assert_message_status (msg, SOUP_STATUS_OK);
+        p = g_bytes_get_data (body, &len);
+        if (n <= 5) {
+                g_assert_cmpmem (p, len, "plain body", 10);
+        } else {
+                /* Undecoded: exactly the bytes the server sent (gzip magic first). */
+                g_assert_cmpuint (len, ==, g_bytes_get_size (nested_body));
+                g_assert_cmpuint (p[0], ==, 0x1f);
+                g_assert_cmpuint (p[1], ==, 0x8b);
+        }
+
+        g_bytes_unref (body);
+        g_object_unref (msg);
+        soup_test_session_abort_unref (session);
+        g_uri_unref (base_uri);
+        soup_test_server_quit_unref (server);
+        g_bytes_unref (nested_body);
+}
+
+int
+main (int argc, char **argv)
+{
+        int ret;
+
+        test_init (argc, argv, NULL);
+
+        /* Deterministic boundary: up to the limit the body is decoded, above it
+         * the body is passed through undecoded (like an unknown coding). */
+        g_test_add_data_func ("/content-encoding/limit/5-decoded", GUINT_TO_POINTER (5), do_boundary_test);
+        g_test_add_data_func ("/content-encoding/limit/6-raw", GUINT_TO_POINTER (6), do_boundary_test);
+        /* Crash guard: 4000 nested decoders overflow a 1 MiB thread stack on
+         * x86_64 (about 3300 suffice); the 100 KB header limit allows ~20000. */
+        g_test_add_data_func ("/content-encoding/many-codings", GUINT_TO_POINTER (4000), do_many_codings_test);
+
+        ret = g_test_run ();
+
+        test_cleanup ();
+        return ret;
+}
