#!/usr/bin/env bash
# ==============================================================================
# Safeer Control — application launcher (shared by .deb and source checkout).
# Resolves the app payload relative to its own location, like the browser launcher.
#
# Safeer Control runs all day in the background: the TV, the tablet and the phone see this
# computer only while it is alive. So the launcher supervises it — if it dies from a signal
# (a crash inside a C library, an out-of-memory kill), the launcher notes it in
# ~/.cache/safeer-control/dnevnik.log and starts it again, at most a few times in a row.
# A normal exit (the user chose Quit) and an ordinary error are never restarted.
# ==============================================================================
PRG="$0"
while [ -h "$PRG" ]; do
    link="$(readlink "$PRG")"
    case "$link" in
        /*) PRG="$link" ;;
        *) PRG="$(dirname "$PRG")/$link" ;;
    esac
done
BIN_DIR="$(cd "$(dirname "$PRG")" && pwd)"
APP_DIR="$(cd "$BIN_DIR/../lib/safeer-control" && pwd)" || {
    echo "Safeer Control: application payload not found next to launcher." >&2
    exit 1
}

PY="${PYTHON:-python3}"

# One-shot runs and an explicitly disabled supervisor run in the foreground.
for arg in "$@"; do
    case "$arg" in
        --version|--help|-h) exec "$PY" "$APP_DIR/safeer_control.py" "$@" ;;
    esac
done
if [ -n "${SAFEER_CONTROL_BREZ_NADZORA:-}" ]; then
    exec "$PY" "$APP_DIR/safeer_control.py" "$@"
fi

DNEVNIK="${XDG_CACHE_HOME:-$HOME/.cache}/safeer-control/dnevnik.log"
mkdir -p "$(dirname "$DNEVNIK")" 2>/dev/null
# Kot Safeer OS (packaging/safeer-os-launcher): brez terminala gresta stderr in stdout v sled.log - prej sta sla v
# /dev/null seje in napake samostojnega Controla niso bile nikjer zapisane (lastnik, 18. 10. 2026).
SLED="${XDG_CACHE_HOME:-$HOME/.cache}/safeer-control/sled.log"
NAJVEC_SLEDI=262144
obrezi_sled() {
    local velikost
    velikost=$(stat -c %s "$SLED" 2>/dev/null || echo 0)
    if [ "$velikost" -gt "$NAJVEC_SLEDI" ]; then
        local rep
        rep="$(tail -c $((NAJVEC_SLEDI / 2)) "$SLED" 2>/dev/null)"
        { echo "... (starejsi zapisi so odrezani)"; printf '%s\n' "$rep"; } > "$SLED" 2>/dev/null || true
    fi
}

NAJVEC_ZAGONOV=5          # more than this in the window below means restarting does not help
OKNO_S=600
zacetek_okna=$(date +%s)
zagonov=0
# Nova razlicica (core/nova_razlicica.py): Control konca s kodo 75, zaganjalnik zazene zaganjalnik nove razlicice.
export SAFEER_CONTROL_NADZOR=$$

while :; do
    if [ -t 2 ]; then
        "$PY" "$APP_DIR/safeer_control.py" "$@"
    else
        obrezi_sled
        "$PY" "$APP_DIR/safeer_control.py" "$@" >>"$SLED" 2>&1
    fi
    koda=$?
    [ "$koda" -eq 0 ] && exit 0                       # normal exit: the user quit Safeer Control
    if [ "$koda" -eq 75 ]; then                       # nova razlicica je namescena: zazene jo njen zaganjalnik
        nacin=()
        for arg in "$@"; do
            case "$arg" in --ozadje) nacin+=("$arg") ;; esac
        done
        [ -x "$PRG" ] && exec "$PRG" "${nacin[@]}"
        exit 0
    fi
    [ "$koda" -lt 128 ] && exit "$koda"               # ordinary error: report it, do not loop

    zdaj=$(date +%s)
    if [ $((zdaj - zacetek_okna)) -gt "$OKNO_S" ]; then
        zacetek_okna=$zdaj
        zagonov=0
    fi
    zagonov=$((zagonov + 1))
    signal=$((koda - 128))
    echo "$(date '+%Y-%m-%d %H:%M:%S') zaganjalnik: Safeer Control se je ustavil zaradi signala $signal (poskus $zagonov)" >> "$DNEVNIK"
    # Pot in koda kot argumenta, ne vstavljena v kodo Pythona (pot z ' bi jo pokvarila ali vanjo vrinila kodo).
    "$PY" -c 'import sys; sys.path.insert(0, sys.argv[1]); from core import os_stabilnost; os_stabilnost.zabelezi_sesutje("safeer-control", int(sys.argv[2]))' "$APP_DIR" "$koda" 2>/dev/null

    if [ "$zagonov" -ge "$NAJVEC_ZAGONOV" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') zaganjalnik: prevec ponovnih zagonov, odneham (glej sled.log)" >> "$DNEVNIK"
        exit "$koda"
    fi
    sleep 2
done
