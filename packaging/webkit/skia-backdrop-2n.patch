+static float maximumBlurSigma(const FilterOperation& filterOperation)
+{
+    switch (filterOperation.type()) {
+    case FilterOperation::Type::Blur:
+        return downcast<BlurFilterOperation>(filterOperation).stdDeviation();
+    case FilterOperation::Type::DropShadow:
+        return downcast<DropShadowFilterOperation>(filterOperation).stdDeviation();
+    default:
+        return 0;
+    }
+}
+
 void SkiaCompositingLayer::setBackdropFilters(const FilterOperations& filterOperations)
 {
     m_backdrop.filter = SkiaCompositingLayerFilters::create(filterOperations, SkTileMode::kClamp);
+    m_backdrop.maximumBlurSigma = 0;
+    for (const auto& filterOperation : filterOperations)
+        m_backdrop.maximumBlurSigma = std::max(m_backdrop.maximumBlurSigma, maximumBlurSigma(filterOperation));
 }
 
