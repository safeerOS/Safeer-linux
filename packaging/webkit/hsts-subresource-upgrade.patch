+bool NetworkLoadChecker::upgradeToHTTPSInPlace(const URL& upgradedURL)
+{
+    // Fetch upgrades the URL of a request before it compares it with the origin of the request: for the origin http://host the
+    // upgraded URL https://host is another origin. m_isSameOriginRequest and the stored credentials policy were decided for
+    // the URL the page asked for, so a load that is same-origin for it and is not for the upgraded URL is not upgraded in
+    // place. The network layer then follows a redirect, which checkRedirection() judges for the new URL: the response needs
+    // CORS to be readable and credentials are sent only when the request asked for them to be included.
+    if (m_isSameOriginRequest && !isSameOrigin(upgradedURL, m_origin.get()))
+        return false;
+
+    // The permission to send a request cross-origin came from a preflight for one URL, and the cache is keyed by it. It does
+    // not hold for another one: an entry for the http URL may have been made by anybody on the network, before the host was
+    // known as HSTS. The redirect checks the https URL, and so asks for its own preflight.
+    if (!m_preflightedURL.isNull() && !(protocolHostAndPortAreEqual(m_preflightedURL, upgradedURL) && m_preflightedURL.path() == upgradedURL.path() && m_preflightedURL.query() == upgradedURL.query()))
+        return false;
+
+    // Tracking prevention judges the URL of every request, so it is asked about the upgraded one too (a redirect would).
+    if (shouldBlockForTrackingPolicy(ResourceRequest { URL { upgradedURL } }))
+        return false;
+
+    // The network layer sends the request to this URL instead of m_url: it is the URL of the response and the previous URL
+    // of the next redirect. The origin is not changed by an upgrade.
+    m_url = upgradedURL;
+    return true;
+}
