+
+// A cross-origin fetch()/XMLHttpRequest that is already in CORS mode (it carries an Origin that differs from the
+// request URL). Upgrading it in place keeps its Origin, method, body and redirect mode, as Fetch does for HSTS,
+// and the response is still checked with CORS. Navigations (of any frame), other subresources and same-origin
+// requests go through a synthetic 307 instead, so the new https origin is handled by the redirect rules.
+static bool isCrossOriginCORSFetch(const ResourceRequest& request)
+{
+    auto requester = request.requester();
+    if (requester != ResourceRequestRequester::Fetch && requester != ResourceRequestRequester::XHR)
+        return false;
+    auto origin = request.httpOrigin();
+    if (origin.isEmpty() || origin == "null"_s)
+        return false;
+    URL originURL { origin };
+    return originURL.isValid() && !protocolHostAndPortAreEqual(originURL, request.url());
 }
 
 void NetworkDataTaskSoup::protocolUpgradedViaHSTS(SoupMessage* soupMessage)
 {
