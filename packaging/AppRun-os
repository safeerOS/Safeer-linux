#!/usr/bin/env bash
# Safeer OS AppImage: Safeer OS + Safeer Control in one bundle (same runtime layout as the browser AppImage).
set -euo pipefail
APPDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TRIPLET=x86_64-linux-gnu
export SAFEER_PORTABLE=1
export PATH="$APPDIR/usr/bin:$PATH"
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/$TRIPLET${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export PYTHONHOME="$APPDIR/usr"
export PYTHONNOUSERSITE=1
export PYTHONPATH="$APPDIR/usr/lib/python3/dist-packages"
export PYTHON="$APPDIR/usr/bin/python3"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/$TRIPLET/girepository-1.0"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$APPDIR/usr/lib/$TRIPLET/gio/modules"
export WEBKIT_EXEC_PATH="$APPDIR/usr/lib/$TRIPLET/webkitgtk-6.0"
export WEBKIT_INJECTED_BUNDLE_PATH="$WEBKIT_EXEC_PATH/injected-bundle"
export GST_PLUGIN_SYSTEM_PATH="$APPDIR/usr/lib/$TRIPLET/gstreamer-1.0"
export GST_PLUGIN_SCANNER="$APPDIR/usr/lib/$TRIPLET/gstreamer1.0/gstreamer-1.0/gst-plugin-scanner"
export SAFEER_PYSIDE6="$APPDIR/opt/pyside6"
# Safeer DRM (pripet ECS in Widevine CDM) je izven usr/ kot PySide6: linuxdeploy njegovih knjiznic ne sme razresevati
# (packaging/build_*appimage.sh); core/safeer_drm.vgrajena_mapa() ga najde tu.
export SAFEER_DRM_MAPA="$APPDIR/opt/safeer-drm"
# Nas rqbit (packaging/rqbit: uradni vir s popravkom za racunalnike brez IPv6) je izven usr/ iz istega razloga;
# core/os_torrent.vgrajen_program() ga najde tu (brez njega Safeer prenese uradni program z GitHuba).
export SAFEER_RQBIT="$APPDIR/opt/rqbit/rqbit"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
# "--control" starts Safeer Control (tray) instead of Safeer OS; Safeer OS starts Control itself when needed.
if [ "${1:-}" = "--control" ]; then
    shift
    exec "$APPDIR/usr/bin/safeer-control" "$@"
fi
# "--ctl" runs safeerctl: Safeer Link from the command line (talks to the Safeer Control that is running).
if [ "${1:-}" = "--ctl" ]; then
    shift
    exec "$APPDIR/usr/bin/safeerctl" "$@"
fi
exec "$APPDIR/usr/bin/safeer-os" "$@"
